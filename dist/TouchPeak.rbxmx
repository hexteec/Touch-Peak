<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Script" referent="RBX0">
		<Properties>
			<string name="Name">TouchPeak</string>
			<ProtectedString name="Source"><![CDATA[--[[
	Touch Peak – touch controls for the Roblox Studio camera.

	  1 finger ............ rotate the camera
	  2 fingers apart ..... zoom
	  2 fingers together .. pan
	  tap ................. select
	  double tap .......... focus the camera on an object
	  press and hold ...... add to / remove from the selection
]]

local RunService = game:GetService("RunService")

-- Plugins also run inside Play Solo sessions; only the edit session needs us.
if not plugin or not RunService:IsEdit() then
	return
end

local Config = require(script.Config)
local App = require(script.App)

local app = App.new(plugin)

local toolbar = plugin:CreateToolbar(Config.ToolbarName)
local button =
	toolbar:CreateButton(Config.ButtonId, app.locale:t("buttonTooltip"), Config.ToolbarIcon, Config.ButtonText)
button.ClickableWhenViewportHidden = true

button.Click:Connect(function()
	app:Toggle()
end)

app.OpenChanged:Connect(function(open)
	button:SetActive(open)
end)

plugin.Deactivation:Connect(function()
	app:OnPluginDeactivated()
end)

plugin.Unloading:Connect(function()
	app:Destroy()
end)
]]></ProtectedString>
		</Properties>
		<Item class="ModuleScript" referent="RBX1">
			<Properties>
				<string name="Name">App</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Wires everything together: settings, input, gestures, camera, selection
	and the on-screen UI.

	"Open" means the window is shown; "active" means touch controls are
	running (and the plugin holds Studio's mouse, so Studio's own select/drag
	tool does not also react to fingers). Opening the plugin activates it.
]]

local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Settings = require(script.Parent.Settings)
local Locale = require(script.Parent.Locale)
local Signal = require(script.Parent.Util.Signal)
local Maid = require(script.Parent.Util.Maid)
local GestureRecognizer = require(script.Parent.Input.GestureRecognizer)
local TouchInput = require(script.Parent.Input.TouchInput)
local CameraController = require(script.Parent.Camera.CameraController)
local SelectionController = require(script.Parent.Selection.SelectionController)
local Theme = require(script.Parent.UI.Theme)
local Overlay = require(script.Parent.UI.Overlay)
local Panel = require(script.Parent.UI.Panel)

local App = {}
App.__index = App

local function describe(instances: { Instance }, locale): string
	if #instances == 1 then
		return instances[1].Name
	end
	return locale:t("toastSelectionItems", #instances)
end

function App.new(plugin: Plugin)
	local self = setmetatable({}, App)
	self._plugin = plugin
	self._maid = Maid.new()
	self._open = false
	self._active = false
	self._touchDetected = UserInputService.TouchEnabled

	self.OpenChanged = Signal.new()

	self.settings = Settings.new(plugin)
	self.locale = Locale.new(self.settings:Get("language"))
	self.recognizer = GestureRecognizer.new()
	self.recognizer:SetCombine(self.settings:Get("combineGestures"))
	self.camera = CameraController.new(self.settings)
	self.selection = SelectionController.new(self.settings)

	self.input = TouchInput.new(self.recognizer, {
		isBlocked = function(position)
			return self.panel ~= nil and self.panel:ContainsPoint(position)
		end,
		mouseEnabled = function()
			return self.settings:Get("mouseInput")
		end,
	})

	self:_bindGestures()
	self:_bindSettings()

	return self
end

-- Lifecycle --------------------------------------------------------------------------

function App:IsOpen(): boolean
	return self._open
end

function App:Toggle()
	if self._open then
		self:Close()
	else
		self:Open()
	end
end

function App:Open()
	if self._open then
		return
	end
	self._open = true
	self:_ensureGui()
	-- Opening always shows the full window; it can be collapsed from there.
	self.panel:SetCollapsed(false, true)
	self.panel:SetVisible(true)
	self:SetActive(true)
	self.OpenChanged:Fire(true)
end

function App:Close()
	if not self._open then
		return
	end
	self._open = false
	self:SetActive(false)
	if self.panel then
		self.panel:SetVisible(false)
	end
	self.OpenChanged:Fire(false)
end

function App:SetActive(active: boolean)
	if active == self._active then
		if self.panel then
			self.panel:SetActive(active)
		end
		return
	end
	self._active = active

	if active then
		-- Take over the mouse so Studio's select/drag tools do not react to the same touches.
		self._plugin:Activate(true)
		self.input:Start()
		self._heartbeat = RunService.Heartbeat:Connect(function(dt)
			-- Both fingers have reported by now: apply this frame's two-finger movement.
			self.recognizer:Flush()
			self.camera:Step(dt)
		end)
	else
		self.input:Stop()
		self.camera:Stop()
		if self._heartbeat then
			self._heartbeat:Disconnect()
			self._heartbeat = nil
		end
		if self.overlay then
			self.overlay:ClearTouches()
			self.overlay:ShowGesture(nil)
		end
		pcall(function()
			if self._plugin:IsActivated() then
				self._plugin:Deactivate()
			end
		end)
	end

	if self.panel then
		self.panel:SetActive(active)
		self.panel:SetTouchCount(0)
		self.panel:SetGesture(nil)
	end
end

-- Studio deactivates the plugin when the user picks another tool (Select, Move, ...).
function App:OnPluginDeactivated()
	if self._active and not self._plugin:IsActivated() then
		self:SetActive(false)
		if self.overlay then
			self.overlay:Toast(self.locale:t("toastPausedByTool"), Theme.Color.Warning)
		end
	end
end

function App:Destroy()
	self:SetActive(false)
	self:_destroyGui()
	self._maid:Clean()
	self.OpenChanged:DisconnectAll()
end

-- GUI ----------------------------------------------------------------------------------

function App:_ensureGui()
	if self.gui then
		return
	end

	-- A previous copy of the plugin (e.g. before a reload) may have left its UI behind.
	local leftover = CoreGui:FindFirstChild("TouchPeak")
	if leftover then
		leftover:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "TouchPeak"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 50
	gui.Archivable = false
	gui.Parent = CoreGui
	self.gui = gui

	self.overlay = Overlay.new(gui, self.settings)
	self:_createPanel()
end

function App:_createPanel()
	self.panel = Panel.new({
		parent = self.gui,
		settings = self.settings,
		locale = self.locale,
		active = self._active,
		touchDetected = self._touchDetected,
		onActiveChanged = function(active)
			self:SetActive(active)
			if active and self.overlay then
				self.overlay:Toast(self.locale:t("toastResumed"), Theme.Color.Success)
			end
		end,
		onClose = function()
			self:Close()
		end,
	})
end

-- Rebuilds the window in place (used when the language changes).
function App:_rebuildPanel()
	if not self.panel then
		return
	end
	local wasVisible = self.panel:IsVisible()
	local wasCollapsed = self.panel:IsCollapsed()
	self.panel:Destroy()
	self:_createPanel()
	self.panel:SetCollapsed(wasCollapsed, true)
	self.panel:SetVisible(wasVisible, true)
end

function App:_destroyGui()
	if self.panel then
		self.panel:Destroy()
		self.panel = nil
	end
	if self.overlay then
		self.overlay:Destroy()
		self.overlay = nil
	end
	if self.gui then
		self.gui:Destroy()
		self.gui = nil
	end
end

-- Wiring -------------------------------------------------------------------------------

function App:_bindGestures()
	local recognizer = self.recognizer
	local camera = self.camera
	local maid = self._maid

	-- Visual feedback for real fingers.
	maid:Give(self.input.TouchBegan:Connect(function(id, position)
		if not self._touchDetected then
			self._touchDetected = true
			if self.panel then
				self.panel:SetTouchDetected(true)
			end
		end
		if self.overlay then
			self.overlay:TouchBegan(id, position)
		end
	end))
	maid:Give(self.input.TouchMoved:Connect(function(id, position)
		if self.overlay then
			self.overlay:TouchMoved(id, position)
		end
	end))
	maid:Give(self.input.TouchEnded:Connect(function(id)
		if self.overlay then
			self.overlay:TouchEnded(id)
		end
	end))

	-- Camera.
	maid:Give(recognizer.InteractionBegan:Connect(function()
		camera:BeginInteraction()
	end))
	maid:Give(recognizer.Rotate:Connect(function(delta)
		camera:Rotate(delta)
	end))
	maid:Give(recognizer.RotateEnded:Connect(function(velocity)
		camera:StartInertia("rotate", velocity)
	end))
	maid:Give(recognizer.TwoFingerBegan:Connect(function(centroid)
		camera:BeginTwoFinger(centroid)
	end))
	maid:Give(recognizer.Pan:Connect(function(delta)
		camera:Pan(delta)
	end))
	maid:Give(recognizer.PanEnded:Connect(function(velocity)
		camera:StartInertia("pan", velocity)
	end))
	maid:Give(recognizer.Zoom:Connect(function(scale, centroid)
		camera:Zoom(scale, centroid)
	end))

	-- Selection.
	maid:Give(recognizer.Tap:Connect(function(position)
		self:_onTap(position)
	end))
	maid:Give(recognizer.DoubleTap:Connect(function(position)
		self:_onDoubleTap(position)
	end))
	maid:Give(recognizer.LongPress:Connect(function(position)
		self:_onLongPress(position)
	end))

	-- Status readouts.
	maid:Give(recognizer.GestureChanged:Connect(function(gesture)
		if self.panel then
			self.panel:SetGesture(gesture)
		end
		if self.overlay then
			self.overlay:ShowGesture(if gesture then self.locale:gesture(gesture) else nil)
		end
	end))
	maid:Give(recognizer.TouchCountChanged:Connect(function(count)
		if self.panel then
			self.panel:SetTouchCount(count)
		end
	end))
end

function App:_bindSettings()
	self._maid:Give(self.settings.Changed:Connect(function(key, value)
		if key == "combineGestures" then
			self.recognizer:SetCombine(value)
		elseif key == "language" then
			self.locale:SetLanguage(value)
			-- Defer so the language button finishes handling its click first.
			task.defer(function()
				self:_rebuildPanel()
			end)
		elseif key == "showTouches" and not value and self.overlay then
			self.overlay:ClearTouches()
		end
	end))
end

function App:_onTap(position: Vector2)
	local target = self.selection:SelectAt(position)
	local overlay = self.overlay
	if not overlay then
		return
	end
	overlay:Ripple(position, Theme.Color.Accent)
	if target then
		overlay:Toast(self.locale:t("toastSelected", target.Name), Theme.Color.Accent)
	else
		overlay:Toast(self.locale:t("toastCleared"), Theme.Color.TextDim)
	end
end

function App:_onDoubleTap(position: Vector2)
	local target = self.selection:SelectAt(position)
	local focusOn = if target then { target } else self.selection:Get()
	local focused = #focusOn > 0 and self.camera:FocusOn(focusOn)

	local overlay = self.overlay
	if not overlay then
		return
	end
	overlay:Ripple(position, Theme.Color.AccentAlt)
	if focused then
		overlay:Toast(self.locale:t("toastFocused", describe(focusOn, self.locale)), Theme.Color.AccentAlt)
	else
		overlay:Toast(self.locale:t("toastNothingToFocus"), Theme.Color.TextDim)
	end
end

function App:_onLongPress(position: Vector2)
	local target, added = self.selection:ToggleAt(position)
	local overlay = self.overlay
	if not overlay or not target then
		return
	end
	overlay:Ripple(position, Theme.Color.Success)
	local key = if added then "toastAdded" else "toastRemoved"
	overlay:Toast(self.locale:t(key, target.Name), if added then Theme.Color.Success else Theme.Color.Warning)
end

return App
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX2">
			<Properties>
				<string name="Name">Camera</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX3">
				<Properties>
					<string name="Name">CameraController</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Moves the Studio edit camera in response to gestures.

	The camera orbits around a pivot point: whatever is in the middle of the
	screen when a gesture starts (or the object you focused on last). Panning
	keeps the point under your fingers glued to them, and pinching zooms
	toward the point between your fingers. When the camera gets very close to
	that point it switches to flying forward, so you can pinch your way
	through walls and into buildings.
]]

local Workspace = game:GetService("Workspace")

local Raycast = require(script.Parent.Raycast)

local MAX_PITCH = math.rad(88)
local DEFAULT_PIVOT_DISTANCE = 40
local MIN_ORBIT_DISTANCE = 0.5
local MIN_ZOOM_DISTANCE = 2
local MAX_ZOOM_DISTANCE = 15000
local MIN_PAN_DEPTH = 1
local FOCUS_AXIS_COS = math.cos(math.rad(3))
local FOCUS_DURATION = 0.45
local FOCUS_MARGIN = 1.15
local MAX_FOCUS_PARTS = 5000

local INERTIA_FRICTION = 5.5 -- 1/s, higher stops sooner
local INERTIA_START_SPEED = 80 -- px/s
local INERTIA_STOP_SPEED = 10 -- px/s

local function sameCFrame(a: CFrame, b: CFrame): boolean
	return (a.Position - b.Position).Magnitude < 1e-3
		and a.LookVector:Dot(b.LookVector) > 1 - 1e-6
		and a.UpVector:Dot(b.UpVector) > 1 - 1e-6
end

-- Camera right vector flattened onto the ground plane, so pitching never rolls the view.
local function horizontalRight(cframe: CFrame): Vector3
	local right = cframe.RightVector
	local flat = Vector3.new(right.X, 0, right.Z)
	if flat.Magnitude < 1e-4 then
		local look = cframe.LookVector
		flat = Vector3.new(-look.Z, 0, look.X)
	end
	if flat.Magnitude < 1e-4 then
		return Vector3.xAxis
	end
	return flat.Unit
end

local function expandBounds(bounds, cframe: CFrame, size: Vector3)
	local half = size / 2
	for _, x in { -1, 1 } do
		for _, y in { -1, 1 } do
			for _, z in { -1, 1 } do
				local corner = cframe:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
				local min, max = bounds.min, bounds.max
				if min then
					bounds.min =
						Vector3.new(math.min(min.X, corner.X), math.min(min.Y, corner.Y), math.min(min.Z, corner.Z))
					bounds.max =
						Vector3.new(math.max(max.X, corner.X), math.max(max.Y, corner.Y), math.max(max.Z, corner.Z))
				else
					bounds.min, bounds.max = corner, corner
				end
			end
		end
	end
end

local function addToBounds(instance: Instance, bounds)
	if instance:IsA("Terrain") then
		return
	elseif instance:IsA("BasePart") then
		expandBounds(bounds, instance.CFrame, instance.Size)
	elseif instance:IsA("Model") then
		local ok, cframe, size = pcall(instance.GetBoundingBox, instance)
		if ok then
			expandBounds(bounds, cframe, size)
		end
	elseif instance:IsA("Attachment") then
		expandBounds(bounds, instance.WorldCFrame, Vector3.zero)
	else
		-- Folders and other containers: use the parts inside them.
		local counted = 0
		for _, descendant in instance:GetDescendants() do
			if descendant:IsA("BasePart") and not descendant:IsA("Terrain") then
				expandBounds(bounds, descendant.CFrame, descendant.Size)
				counted += 1
				if counted >= MAX_FOCUS_PARTS then
					break
				end
			end
		end
	end
end

local CameraController = {}
CameraController.__index = CameraController

function CameraController.new(settings)
	local self = setmetatable({}, CameraController)
	self._settings = settings
	self._pivot = nil :: Vector3?
	self._lastCFrame = nil :: CFrame?
	self._anchor = nil :: Vector3?
	self._inertia = nil
	self._focus = nil
	return self
end

function CameraController:_camera(): Camera?
	return Workspace.CurrentCamera
end

-- True while the camera is still where we last put it.
function CameraController:_isOurs(camera: Camera): boolean
	return self._lastCFrame ~= nil and sameCFrame(camera.CFrame, self._lastCFrame)
end

function CameraController:_apply(camera: Camera, cframe: CFrame, pivot: Vector3)
	camera.CFrame = cframe
	self._pivot = pivot
	self._lastCFrame = camera.CFrame
	if self._settings:Get("rotateMode") == "orbit" then
		camera.Focus = CFrame.new(pivot)
	end
end

function CameraController:_resolvePivot(camera: Camera): Vector3
	local cframe = camera.CFrame
	local look = cframe.LookVector

	-- 1. Whatever sits in the middle of the screen.
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	local hit = Raycast.cast(ray.Origin, ray.Direction * Raycast.MaxDistance, Raycast.isVisible)
	if hit then
		local depth = math.max((hit.Position - cframe.Position):Dot(look), MIN_ORBIT_DISTANCE)
		return cframe.Position + look * depth
	end

	-- 2. Studio's own focus point, if it is still in front of the camera.
	local toFocus = camera.Focus.Position - cframe.Position
	local depth = toFocus:Dot(look)
	if depth > MIN_ORBIT_DISTANCE and depth < MAX_ZOOM_DISTANCE and toFocus.Unit:Dot(look) > FOCUS_AXIS_COS then
		return cframe.Position + look * depth
	end

	-- 3. Empty sky: a point a little in front of the camera.
	return cframe.Position + look * DEFAULT_PIVOT_DISTANCE
end

function CameraController:_getPivot(camera: Camera): Vector3
	if self._settings:Get("rotateMode") == "look" then
		return camera.CFrame.Position
	end
	if self._pivot and self:_isOurs(camera) then
		return self._pivot
	end
	local pivot = self:_resolvePivot(camera)
	self._pivot = pivot
	return pivot
end

-- World point under a screen position, used as the zoom target and pan depth.
function CameraController:_findAnchor(camera: Camera, screenPosition: Vector2, pivot: Vector3): Vector3
	local hit, ray = Raycast.fromScreen(camera, screenPosition, Raycast.isVisible)
	if hit then
		return hit.Position
	end

	local cframe = camera.CFrame
	local depth = (pivot - cframe.Position):Dot(cframe.LookVector)
	if depth < MIN_PAN_DEPTH then
		depth = DEFAULT_PIVOT_DISTANCE
	end
	local along = depth / math.max(ray.Direction:Dot(cframe.LookVector), 0.05)
	return ray.Origin + ray.Direction * along
end

-- Gesture entry points ------------------------------------------------------------

function CameraController:BeginInteraction()
	self._inertia = nil
	self._focus = nil
	self._anchor = nil
end

function CameraController:BeginTwoFinger(centroid: Vector2)
	self._inertia = nil
	self._focus = nil
	local camera = self:_camera()
	if not camera then
		return
	end
	self._anchor = self:_findAnchor(camera, centroid, self:_getPivot(camera))
end

function CameraController:Rotate(delta: Vector2)
	local camera = self:_camera()
	if not camera then
		return
	end

	local settings = self._settings
	local viewport = camera.ViewportSize
	-- Dragging across the short side of the viewport turns the camera 180 degrees.
	local radiansPerPixel = math.pi / math.max(math.min(viewport.X, viewport.Y), 100)
	radiansPerPixel *= settings:Get("rotateSensitivity")
	if settings:Get("invertRotate") then
		radiansPerPixel = -radiansPerPixel
	end

	local cframe = camera.CFrame
	local pivot = self:_getPivot(camera)
	local look = cframe.LookVector

	local yaw = -delta.X * radiansPerPixel
	local currentPitch = math.asin(math.clamp(look.Y, -1, 1))
	local targetPitch = math.clamp(currentPitch - delta.Y * radiansPerPixel, -MAX_PITCH, MAX_PITCH)
	local pitch = targetPitch - currentPitch

	local rotation = CFrame.fromAxisAngle(Vector3.yAxis, yaw) * CFrame.fromAxisAngle(horizontalRight(cframe), pitch)
	local position = pivot + rotation:VectorToWorldSpace(cframe.Position - pivot)
	local newLook = rotation:VectorToWorldSpace(look)

	self:_apply(camera, CFrame.lookAt(position, position + newLook), pivot)
end

function CameraController:Pan(delta: Vector2)
	local camera = self:_camera()
	if not camera then
		return
	end

	local settings = self._settings
	local cframe = camera.CFrame
	local pivot = self:_getPivot(camera)
	local anchor = self._anchor or pivot

	-- Size of one pixel at the depth of the point under the fingers.
	local depth = math.max((anchor - cframe.Position):Dot(cframe.LookVector), MIN_PAN_DEPTH)
	local viewport = camera.ViewportSize
	local studsPerPixel = 2 * depth * math.tan(math.rad(camera.FieldOfView) / 2) / math.max(viewport.Y, 1)
	studsPerPixel *= settings:Get("panSensitivity")
	if settings:Get("invertPan") then
		studsPerPixel = -studsPerPixel
	end

	local offset = (cframe.UpVector * delta.Y - cframe.RightVector * delta.X) * studsPerPixel
	self:_apply(camera, cframe + offset, pivot + offset)
end

-- scale < 1 moves closer (fingers spread apart), scale > 1 moves away.
function CameraController:Zoom(scale: number, centroid: Vector2)
	local camera = self:_camera()
	if not camera then
		return
	end

	local factor = scale ^ self._settings:Get("zoomSensitivity")
	if factor ~= factor or factor <= 0 then
		return
	end

	local cframe = camera.CFrame
	local position = cframe.Position
	local pivot = self:_getPivot(camera)
	local anchor = self._anchor
	if not anchor then
		anchor = self:_findAnchor(camera, centroid, pivot)
		self._anchor = anchor
	end

	local toAnchor = anchor - position
	local distance = toAnchor.Magnitude
	if distance < 1e-4 then
		return
	end
	local direction = toAnchor / distance

	local move = (1 - factor) * math.max(distance, MIN_ZOOM_DISTANCE)
	local newDistance = distance - move
	if newDistance > MAX_ZOOM_DISTANCE then
		newDistance = math.max(MAX_ZOOM_DISTANCE, distance)
		move = distance - newDistance
	end
	local offset = direction * move

	local newPivot
	if distance >= MIN_ZOOM_DISTANCE and newDistance >= MIN_ZOOM_DISTANCE then
		-- Scale everything around the anchor; the pivot stays on the view axis.
		newPivot = anchor + (pivot - anchor) * (newDistance / distance)
	else
		-- Too close to scale any further: fly forward and push the anchor ahead.
		newPivot = pivot + offset
		self._anchor = anchor + offset
	end

	self:_apply(camera, cframe + offset, newPivot)
end

function CameraController:StartInertia(kind: "rotate" | "pan", velocity: Vector2)
	if not self._settings:Get("inertia") or velocity.Magnitude < INERTIA_START_SPEED then
		return
	end
	self._inertia = { kind = kind, velocity = velocity }
end

-- Smoothly moves the camera so the given instances fill the view.
function CameraController:FocusOn(instances: { Instance }): boolean
	local camera = self:_camera()
	if not camera then
		return false
	end

	local bounds = {}
	for _, instance in instances do
		addToBounds(instance, bounds)
	end
	if not bounds.min then
		return false
	end

	local center = (bounds.min + bounds.max) / 2
	local radius = math.max((bounds.max - bounds.min).Magnitude / 2, 1)

	local viewport = camera.ViewportSize
	local verticalFov = math.rad(camera.FieldOfView)
	local horizontalFov = 2 * math.atan(math.tan(verticalFov / 2) * viewport.X / math.max(viewport.Y, 1))
	local halfAngle = math.min(verticalFov, horizontalFov) / 2
	local distance = math.clamp(radius / math.sin(halfAngle) * FOCUS_MARGIN, MIN_ZOOM_DISTANCE, MAX_ZOOM_DISTANCE)

	local from = camera.CFrame
	local to = CFrame.new(center - from.LookVector * distance) * from.Rotation

	self._inertia = nil
	self._anchor = nil
	self._lastCFrame = from
	self._focus = { from = from, to = to, pivot = center, elapsed = 0 }
	return true
end

function CameraController:IsAnimating(): boolean
	return self._focus ~= nil or self._inertia ~= nil
end

function CameraController:Stop()
	self._inertia = nil
	self._focus = nil
	self._anchor = nil
end

-- Advances inertia and focus animations; call every frame.
function CameraController:Step(dt: number)
	if not (self._focus or self._inertia) then
		return
	end
	local camera = self:_camera()
	if not camera then
		return
	end
	if not self:_isOurs(camera) then
		-- Something else (Studio's own controls) moved the camera: give way.
		self:Stop()
		return
	end

	local focus = self._focus
	if focus then
		focus.elapsed += dt
		local alpha = math.clamp(focus.elapsed / FOCUS_DURATION, 0, 1)
		local eased = 1 - (1 - alpha) ^ 3
		self:_apply(camera, focus.from:Lerp(focus.to, eased), focus.pivot)
		if alpha >= 1 then
			self._focus = nil
		end
		return
	end

	local inertia = self._inertia
	local decay = math.exp(-INERTIA_FRICTION * dt)
	-- Exact distance travelled by an exponentially decaying velocity over dt.
	local delta = inertia.velocity * ((1 - decay) / INERTIA_FRICTION)
	inertia.velocity *= decay
	if inertia.velocity.Magnitude < INERTIA_STOP_SPEED then
		self._inertia = nil
	end

	if inertia.kind == "rotate" then
		self:Rotate(delta)
	else
		self:Pan(delta)
	end
end

return CameraController
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">Raycast</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Raycasting helpers that can skip over unwanted hits (locked or invisible
	parts) instead of stopping at them.
]]

local Workspace = game:GetService("Workspace")

local Raycast = {}

Raycast.MaxDistance = 15000 -- longest ray workspace:Raycast supports
local MAX_SKIPS = 32

-- Casts a ray and returns the first hit accepted by `accept` (or nil).
function Raycast.cast(origin: Vector3, direction: Vector3, accept: (Instance) -> boolean): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local excluded = {}

	for _ = 1, MAX_SKIPS do
		params.FilterDescendantsInstances = excluded
		local result = Workspace:Raycast(origin, direction, params)
		if not result then
			return nil
		end
		if accept(result.Instance) then
			return result
		end
		table.insert(excluded, result.Instance)
	end
	return nil
end

-- Casts from a GUI-space screen position (as reported by InputObject.Position).
function Raycast.fromScreen(camera: Camera, position: Vector2, accept: (Instance) -> boolean): (RaycastResult?, Ray)
	local ray = camera:ScreenPointToRay(position.X, position.Y)
	return Raycast.cast(ray.Origin, ray.Direction * Raycast.MaxDistance, accept), ray
end

-- Anything the eye can see stops the ray (used for camera pivots).
function Raycast.isVisible(instance: Instance): boolean
	if instance:IsA("BasePart") then
		return instance.Transparency < 0.98
	end
	return true
end

return Raycast
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX5">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[return {
	Version = "1.0.0",
	ToolbarName = "Touch Peak",
	ButtonId = "TouchPeakToggle",
	ButtonText = "Touch Peak",
	-- Upload assets/icon.png to Roblox (Create > Decals) and paste "rbxassetid://<id>" here
	-- to give the toolbar button an icon. Left empty, Studio shows the text only.
	ToolbarIcon = "",
}
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX6">
			<Properties>
				<string name="Name">Input</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX7">
				<Properties>
					<string name="Name">GestureRecognizer</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Turns raw touch points into high level gestures.

	  1 finger drag ............ Rotate(delta)        -> RotateEnded(velocity)
	  2 fingers, apart/together  Zoom(scale, centroid)
	  2 fingers, same direction  Pan(delta, centroid) -> PanEnded(velocity)
	  quick tap ................ Tap(position)
	  second quick tap ......... DoubleTap(position)
	  press and hold ........... LongPress(position)

	Touches are identified by any key (Roblox reuses the same InputObject for
	the whole life of a finger), so the recognizer does not depend on Studio
	and can be driven from tests with a fake clock.

	A two-finger gesture is locked to either zoom or pan once the fingers have
	moved far enough to tell the two apart, unless `combine` is enabled.
	After a two-finger gesture (or a long press) the remaining finger is
	ignored until every finger is lifted, so lifting one finger never makes
	the camera jump.

	Roblox reports each finger in its own input event. Two-finger movement is
	therefore collected and evaluated once per frame by `Flush()` (call it from
	Heartbeat); otherwise the first finger of a pan would look like a pinch.
	If nobody flushes, pending movement is evaluated after `maxBatchDelay`.
]]

local Signal = require(script.Parent.Parent.Util.Signal)

local DEFAULT_CONFIG = {
	tapSlop = 10, -- px a finger may drift and still count as a tap
	doubleTapTime = 0.35, -- s between two taps
	doubleTapSlop = 40, -- px between two taps
	longPressTime = 0.55, -- s
	twoFingerLockDistance = 10, -- px before deciding between zoom and pan
	velocityWindow = 0.1, -- s of movement used for the release velocity
	releaseStaleTime = 0.08, -- s without movement before release cancels inertia
	maxReleaseSpeed = 6000, -- px/s
	maxBatchDelay = 0.05, -- s two-finger movement may wait for Flush()
}

export type Mode = "idle" | "pending" | "rotate" | "pendingTwo" | "zoom" | "pan" | "both" | "blocked"

local GestureRecognizer = {}
GestureRecognizer.__index = GestureRecognizer

GestureRecognizer.DefaultConfig = DEFAULT_CONFIG

export type Options = {
	clock: (() -> number)?,
	delay: ((number, () -> ()) -> any)?,
	config: { [string]: number }?,
}

function GestureRecognizer.new(options: Options?)
	local opts: Options = options or {}
	local self = setmetatable({}, GestureRecognizer)

	self._clock = opts.clock or os.clock
	self._delay = opts.delay or task.delay
	self._config = table.clone(DEFAULT_CONFIG)
	for key, value in opts.config or {} do
		self._config[key] = value
	end

	self._combine = false
	self._mode = "idle" :: Mode
	self._gesture = nil :: string?
	self._touches = {} -- id -> record
	self._order = {} -- ids of the (at most two) tracked fingers
	self._ignored = {} -- id -> true for extra fingers
	self._count = 0
	self._samples = {}
	self._lastTap = nil
	self._longPressToken = 0

	self._startCentroid = nil
	self._startDistance = nil
	self._prevCentroid = nil
	self._prevDistance = nil
	self._pendingSince = nil -- time of the oldest unflushed two-finger movement

	self.InteractionBegan = Signal.new()
	self.TouchCountChanged = Signal.new()
	self.GestureChanged = Signal.new()
	self.Rotate = Signal.new()
	self.RotateEnded = Signal.new()
	self.TwoFingerBegan = Signal.new()
	self.Pan = Signal.new()
	self.PanEnded = Signal.new()
	self.Zoom = Signal.new()
	self.Tap = Signal.new()
	self.DoubleTap = Signal.new()
	self.LongPress = Signal.new()

	return self
end

function GestureRecognizer:SetCombine(combine: boolean)
	self._combine = combine
end

function GestureRecognizer:GetMode(): Mode
	return self._mode
end

function GestureRecognizer:GetGesture(): string?
	return self._gesture
end

function GestureRecognizer:GetTouchCount(): number
	return self._count
end

function GestureRecognizer:IsTracking(id: any): boolean
	return self._touches[id] ~= nil or self._ignored[id] ~= nil
end

-- Touch events ----------------------------------------------------------------

function GestureRecognizer:TouchBegan(id: any, position: Vector2)
	if self:IsTracking(id) then
		return
	end
	self:Flush()

	if #self._order >= 2 or self._mode == "blocked" then
		self._ignored[id] = true
		self:_updateCount()
		return
	end

	local record = {
		id = id,
		start = position,
		position = position,
		startTime = self._clock(),
	}
	self._touches[id] = record
	table.insert(self._order, id)

	if #self._order == 1 then
		self._mode = "pending"
		self._samples = {}
		self.InteractionBegan:Fire()
		self:_scheduleLongPress(record)
	else
		self:_cancelLongPress()
		self._lastTap = nil
		self._samples = {}

		local a, b = self:_pair()
		local centroid = (a.position + b.position) / 2
		local distance = math.max((a.position - b.position).Magnitude, 1)
		self._startCentroid = centroid
		self._startDistance = distance
		self._prevCentroid = centroid
		self._prevDistance = distance

		self._mode = "pendingTwo"
		self:_setGesture(nil)
		self.TwoFingerBegan:Fire(centroid)
	end

	self:_updateCount()
end

function GestureRecognizer:TouchMoved(id: any, position: Vector2)
	local record = self._touches[id]
	if not record then
		return
	end

	local previous = record.position
	record.position = position
	local mode = self._mode
	local now = self._clock()

	if mode == "pending" then
		local offset = position - record.start
		if offset.Magnitude > self._config.tapSlop then
			self:_cancelLongPress()
			self._mode = "rotate"
			self:_setGesture("rotate")
			-- Include the slop so the camera catches up with the finger.
			self:_addSample(now, offset)
			self.Rotate:Fire(offset)
		end
	elseif mode == "rotate" then
		local delta = position - previous
		if delta.Magnitude > 0 then
			self:_addSample(now, delta)
			self.Rotate:Fire(delta)
		end
	elseif mode == "pendingTwo" or mode == "zoom" or mode == "pan" or mode == "both" then
		self._pendingSince = self._pendingSince or now
		if now - self._pendingSince >= self._config.maxBatchDelay then
			self:Flush()
		end
	end
end

-- Applies two-finger movement collected since the last call. Call once per frame.
function GestureRecognizer:Flush()
	if self._pendingSince == nil then
		return
	end
	self._pendingSince = nil
	local mode = self._mode
	if mode == "pendingTwo" or mode == "zoom" or mode == "pan" or mode == "both" then
		self:_updateTwoFinger(self._clock())
	end
end

function GestureRecognizer:TouchEnded(id: any, position: Vector2?)
	if self._ignored[id] then
		self._ignored[id] = nil
		self:_settle()
		return
	end

	local record = self._touches[id]
	if not record then
		return
	end
	if position and position ~= record.position then
		self:TouchMoved(id, position)
	end
	self:Flush()

	local now = self._clock()
	local mode = self._mode
	self._touches[id] = nil
	table.remove(self._order, table.find(self._order, id))

	if mode == "pending" then
		self:_cancelLongPress()
		self._mode = "idle"
		self:_handleTap(record, now)
	elseif mode == "rotate" then
		self._mode = "idle"
		self:_setGesture(nil)
		self.RotateEnded:Fire(self:_releaseVelocity(now))
	elseif mode == "pan" or mode == "both" then
		self._mode = "blocked"
		self:_setGesture(nil)
		self.PanEnded:Fire(self:_releaseVelocity(now))
	elseif mode == "zoom" or mode == "pendingTwo" then
		self._mode = "blocked"
		self:_setGesture(nil)
	end

	self:_settle()
end

-- Forget every finger (e.g. when the plugin gets paused).
function GestureRecognizer:Cancel()
	self:_cancelLongPress()
	table.clear(self._touches)
	table.clear(self._order)
	table.clear(self._ignored)
	self._samples = {}
	self._lastTap = nil
	self._pendingSince = nil
	self._mode = "idle"
	self:_setGesture(nil)
	self:_updateCount()
end

-- Internals -------------------------------------------------------------------

function GestureRecognizer:_pair()
	return self._touches[self._order[1]], self._touches[self._order[2]]
end

function GestureRecognizer:_updateTwoFinger(now: number)
	local a, b = self:_pair()
	if not (a and b) then
		return
	end

	local centroid = (a.position + b.position) / 2
	local distance = math.max((a.position - b.position).Magnitude, 1)

	if self._mode == "pendingTwo" then
		local spread = math.abs(distance - self._startDistance)
		local travel = (centroid - self._startCentroid).Magnitude
		if math.max(spread, travel) < self._config.twoFingerLockDistance then
			return
		end

		local mode
		if self._combine then
			mode = "both"
		elseif spread > travel then
			mode = "zoom"
		else
			mode = "pan"
		end
		self._mode = mode
		self:_setGesture(mode)
		-- _prevCentroid/_prevDistance still hold the starting values, so the
		-- movement made while deciding is applied below.
	end

	local mode = self._mode
	local panDelta = centroid - self._prevCentroid
	local scale = self._prevDistance / distance

	if (mode == "pan" or mode == "both") and panDelta.Magnitude > 0 then
		self:_addSample(now, panDelta)
		self.Pan:Fire(panDelta, centroid)
	end
	if (mode == "zoom" or mode == "both") and scale ~= 1 then
		self.Zoom:Fire(scale, centroid)
	end

	self._prevCentroid = centroid
	self._prevDistance = distance
end

function GestureRecognizer:_handleTap(record, now: number)
	local position = record.position
	local last = self._lastTap
	local config = self._config

	if
		last
		and now - last.time <= config.doubleTapTime
		and (position - last.position).Magnitude <= config.doubleTapSlop
	then
		self._lastTap = nil
		self.DoubleTap:Fire(position)
	else
		self._lastTap = { time = now, position = position }
		self.Tap:Fire(position)
	end
end

function GestureRecognizer:_scheduleLongPress(record)
	self._longPressToken += 1
	local token = self._longPressToken

	self._delay(self._config.longPressTime, function()
		if token ~= self._longPressToken then
			return
		end
		if self._mode ~= "pending" or self._touches[record.id] ~= record then
			return
		end
		self._mode = "blocked"
		self._lastTap = nil
		self.LongPress:Fire(record.position)
	end)
end

function GestureRecognizer:_cancelLongPress()
	self._longPressToken += 1
end

function GestureRecognizer:_addSample(now: number, delta: Vector2)
	local samples = self._samples
	table.insert(samples, { time = now, delta = delta })

	local cutoff = now - self._config.velocityWindow
	while samples[1] and samples[1].time < cutoff do
		table.remove(samples, 1)
	end
end

function GestureRecognizer:_releaseVelocity(now: number): Vector2
	local samples = self._samples
	self._samples = {}

	local config = self._config
	local newest = samples[#samples]
	if not newest or now - newest.time > config.releaseStaleTime then
		return Vector2.zero
	end

	local cutoff = now - config.velocityWindow
	local total = Vector2.zero
	local first, count = nil, 0
	for _, sample in samples do
		if sample.time >= cutoff then
			total += sample.delta
			first = first or sample.time
			count += 1
		end
	end
	if count == 0 then
		return Vector2.zero
	end

	-- n samples spaced dt apart describe n intervals of movement.
	local span = newest.time - first
	span = if count > 1 then span + span / (count - 1) else 1 / 60
	span = math.max(span, 1 / 240)

	local velocity = total / span
	if velocity.Magnitude > config.maxReleaseSpeed then
		velocity = velocity.Unit * config.maxReleaseSpeed
	end
	return velocity
end

function GestureRecognizer:_settle()
	if #self._order == 0 and next(self._ignored) == nil and self._mode == "blocked" then
		self._mode = "idle"
	end
	self:_updateCount()
end

function GestureRecognizer:_setGesture(gesture: string?)
	if self._gesture == gesture then
		return
	end
	self._gesture = gesture
	self.GestureChanged:Fire(gesture)
end

function GestureRecognizer:_updateCount()
	local count = #self._order
	for _ in self._ignored do
		count += 1
	end
	if count ~= self._count then
		self._count = count
		self.TouchCountChanged:Fire(count)
	end
end

return GestureRecognizer
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8">
				<Properties>
					<string name="Name">TouchInput</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Feeds UserInputService touches (and, optionally, the left mouse button as a
	single "finger") into a GestureRecognizer.

	Touches that start on top of the plugin's own UI are left alone for their
	whole lifetime, so dragging the panel never moves the camera.
]]

local UserInputService = game:GetService("UserInputService")

local Maid = require(script.Parent.Parent.Util.Maid)
local Signal = require(script.Parent.Parent.Util.Signal)

local MOUSE_ID = "Mouse"
-- Windows turns touches into fake mouse clicks shortly after the real touch
-- events; ignore the mouse for a moment after any touch to avoid doubling up.
local MOUSE_AFTER_TOUCH_COOLDOWN = 0.75

local TouchInput = {}
TouchInput.__index = TouchInput

export type Options = {
	isBlocked: (position: Vector2) -> boolean,
	mouseEnabled: () -> boolean,
}

local function toVector2(position: Vector3): Vector2
	return Vector2.new(position.X, position.Y)
end

function TouchInput.new(recognizer, options: Options)
	local self = setmetatable({}, TouchInput)
	self._recognizer = recognizer
	self._isBlocked = options.isBlocked
	self._mouseEnabled = options.mouseEnabled
	self._maid = Maid.new()
	self._running = false
	self._touches = {} -- InputObject -> true for touches we forward
	self._mouseDown = false
	self._lastTouchTime = -math.huge

	-- Visual feedback hooks (only real fingers, the mouse has its own cursor).
	self.TouchBegan = Signal.new()
	self.TouchMoved = Signal.new()
	self.TouchEnded = Signal.new()

	return self
end

function TouchInput:IsRunning(): boolean
	return self._running
end

function TouchInput:Start()
	if self._running then
		return
	end
	self._running = true

	-- gameProcessedEvent is deliberately ignored: in edit mode Studio may
	-- mark viewport touches as processed. Our own UI is filtered by isBlocked.
	self._maid:Give(UserInputService.InputBegan:Connect(function(input)
		self:_onBegan(input)
	end))
	self._maid:Give(UserInputService.InputChanged:Connect(function(input)
		self:_onChanged(input)
	end))
	self._maid:Give(UserInputService.InputEnded:Connect(function(input)
		self:_onEnded(input)
	end))
	-- Touches cancelled by the OS (e.g. a palm rejection) may skip InputEnded.
	self._maid:Give(UserInputService.TouchEnded:Connect(function(input)
		self:_onEnded(input)
	end))
	-- Fingers lifted while Studio is in the background never report back.
	pcall(function()
		self._maid:Give(UserInputService.WindowFocusReleased:Connect(function()
			self:_releaseAll()
		end))
	end)
end

function TouchInput:Stop()
	if not self._running then
		return
	end
	self._running = false
	self._maid:Clean()
	self:_releaseAll()
end

-- Forgets every finger without triggering taps or inertia.
function TouchInput:_releaseAll()
	for input in self._touches do
		self.TouchEnded:Fire(input)
	end
	table.clear(self._touches)
	self._mouseDown = false
	self._recognizer:Cancel()
end

-- If a finger finished without telling us, start over instead of mixing it
-- into the next gesture (and without turning it into a tap).
function TouchInput:_dropStaleTouches()
	for input in self._touches do
		local state = input.UserInputState
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			self:_releaseAll()
			return
		end
	end
end

function TouchInput:_onBegan(input: InputObject)
	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.Touch then
		self._lastTouchTime = os.clock()
		if self._touches[input] then
			return
		end
		local position = toVector2(input.Position)
		if self._isBlocked(position) then
			return
		end
		-- A real touch takes over from a mouse "finger" Windows synthesized from
		-- it. Drop that one silently so it cannot count as a tap.
		if self._mouseDown then
			self._mouseDown = false
			self._recognizer:Cancel()
		end
		self:_dropStaleTouches()
		self._touches[input] = true
		self.TouchBegan:Fire(input, position)
		self._recognizer:TouchBegan(input, position)
	elseif inputType == Enum.UserInputType.MouseButton1 then
		if not self._mouseEnabled() or self._mouseDown or next(self._touches) then
			return
		end
		if os.clock() - self._lastTouchTime < MOUSE_AFTER_TOUCH_COOLDOWN then
			return
		end
		local position = toVector2(input.Position)
		if self._isBlocked(position) then
			return
		end
		self._mouseDown = true
		self._recognizer:TouchBegan(MOUSE_ID, position)
	end
end

function TouchInput:_onChanged(input: InputObject)
	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.Touch then
		self._lastTouchTime = os.clock()
		if self._touches[input] then
			local position = toVector2(input.Position)
			self.TouchMoved:Fire(input, position)
			self._recognizer:TouchMoved(input, position)
		end
	elseif inputType == Enum.UserInputType.MouseMovement then
		if self._mouseDown then
			self._recognizer:TouchMoved(MOUSE_ID, toVector2(input.Position))
		end
	end
end

function TouchInput:_onEnded(input: InputObject)
	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.Touch then
		self._lastTouchTime = os.clock()
		if self._touches[input] then
			self._touches[input] = nil
			self.TouchEnded:Fire(input)
			self._recognizer:TouchEnded(input, toVector2(input.Position))
		end
	elseif inputType == Enum.UserInputType.MouseButton1 then
		if self._mouseDown then
			self._mouseDown = false
			-- The button's InputObject may still hold the press position; keep the last move.
			self._recognizer:TouchEnded(MOUSE_ID)
		end
	end
end

return TouchInput
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX9">
			<Properties>
				<string name="Name">Locale</string>
				<ProtectedString name="Source"><![CDATA[--[[
	UI strings in Polish and English.

	The "auto" language picks Polish when Studio or the operating system runs
	in Polish, English otherwise.
]]

local STRINGS = {
	pl = {
		buttonTooltip = "Sterowanie kamerą i zaznaczaniem dotykiem",

		statusActive = "Aktywny",
		statusPaused = "Wstrzymany",
		touchControl = "Sterowanie dotykiem",
		fingers = "Palce",
		gesture = "Gest",
		noGesture = "brak",

		dragHint = "Przeciągnij nagłówek, aby przesunąć",

		tabGestures = "Gesty",
		tabSettings = "Ustawienia",

		gestureRotate = "Obrót kamery",
		gestureRotateHint = "Przesuń jednym palcem",
		gestureZoom = "Przybliżanie",
		gestureZoomHint = "Rozsuń lub zsuń dwa palce",
		gesturePan = "Przesuwanie (Pan)",
		gesturePanHint = "Przesuń dwa palce w tę samą stronę",
		gestureTap = "Zaznacz obiekt",
		gestureTapHint = "Stuknij obiekt – pusty obszar odznacza",
		gestureDoubleTap = "Skup kamerę",
		gestureDoubleTapHint = "Stuknij dwukrotnie obiekt",
		gestureLongPress = "Dodaj / usuń z zaznaczenia",
		gestureLongPressHint = "Przytrzymaj palec na obiekcie",

		hudRotate = "Obrót",
		hudZoom = "Przybliżanie",
		hudPan = "Przesuwanie",
		hudBoth = "Przybliżanie + przesuwanie",

		toastSelected = "Zaznaczono: %s",
		toastAdded = "Dodano: %s",
		toastRemoved = "Odznaczono: %s",
		toastCleared = "Wyczyszczono zaznaczenie",
		toastFocused = "Kamera na: %s",
		toastNothingToFocus = "Brak obiektu do pokazania",
		toastPausedByTool = "Wstrzymano – wybrano inne narzędzie",
		toastResumed = "Sterowanie dotykiem włączone",
		toastSelectionItems = "%d obiektów",

		sectionSensitivity = "CZUŁOŚĆ",
		rotateSpeed = "Obrót",
		zoomSpeed = "Przybliżanie",
		panSpeed = "Przesuwanie",

		sectionCamera = "KAMERA",
		rotateMode = "Tryb obrotu",
		rotateModeOrbit = "Orbita",
		rotateModeLook = "W miejscu",
		inertia = "Bezwładność",
		inertiaHint = "Kamera płynnie wyhamowuje",
		combineGestures = "Zoom i pan razem",
		combineGesturesHint = "Oba gesty jednocześnie",
		invertRotate = "Odwróć obrót",
		invertRotateHint = "Odwrotny kierunek obrotu",
		invertPan = "Odwróć przesuwanie",
		invertPanHint = "Kamera leci w stronę ruchu palców",

		sectionSelection = "ZAZNACZANIE I WIDOK",
		selectModels = "Zaznaczaj całe modele",
		selectModelsHint = "Tak jak kliknięcie w Studio",
		showTouches = "Pokazuj dotyk",
		showTouchesHint = "Kółka pod palcami",
		mouseInput = "Mysz i rysik",
		mouseInputHint = "Lewy przycisk działa jak palec",
		language = "Język",
		languageAuto = "Auto",

		sectionInfo = "DIAGNOSTYKA",
		touchScreen = "Ekran dotykowy",
		detected = "wykryty",
		notDetected = "nie wykryto",
		reset = "Przywróć domyślne",
	},

	en = {
		buttonTooltip = "Touch camera controls and selection",

		statusActive = "Active",
		statusPaused = "Paused",
		touchControl = "Touch controls",
		fingers = "Fingers",
		gesture = "Gesture",
		noGesture = "none",

		dragHint = "Drag the header to move",

		tabGestures = "Gestures",
		tabSettings = "Settings",

		gestureRotate = "Rotate camera",
		gestureRotateHint = "Drag with one finger",
		gestureZoom = "Zoom",
		gestureZoomHint = "Pinch two fingers in or out",
		gesturePan = "Pan",
		gesturePanHint = "Drag two fingers the same way",
		gestureTap = "Select object",
		gestureTapHint = "Tap an object – empty space clears",
		gestureDoubleTap = "Focus camera",
		gestureDoubleTapHint = "Double-tap an object",
		gestureLongPress = "Add / remove from selection",
		gestureLongPressHint = "Press and hold on an object",

		hudRotate = "Rotate",
		hudZoom = "Zoom",
		hudPan = "Pan",
		hudBoth = "Zoom + pan",

		toastSelected = "Selected: %s",
		toastAdded = "Added: %s",
		toastRemoved = "Removed: %s",
		toastCleared = "Selection cleared",
		toastFocused = "Focused: %s",
		toastNothingToFocus = "Nothing to focus on",
		toastPausedByTool = "Paused – another tool was selected",
		toastResumed = "Touch controls on",
		toastSelectionItems = "%d objects",

		sectionSensitivity = "SENSITIVITY",
		rotateSpeed = "Rotate",
		zoomSpeed = "Zoom",
		panSpeed = "Pan",

		sectionCamera = "CAMERA",
		rotateMode = "Rotation mode",
		rotateModeOrbit = "Orbit",
		rotateModeLook = "In place",
		inertia = "Inertia",
		inertiaHint = "Camera glides to a stop",
		combineGestures = "Zoom and pan together",
		combineGesturesHint = "Both gestures at once",
		invertRotate = "Invert rotation",
		invertRotateHint = "Reverse the rotation direction",
		invertPan = "Invert pan",
		invertPanHint = "Camera flies along with your fingers",

		sectionSelection = "SELECTION & VIEW",
		selectModels = "Select whole models",
		selectModelsHint = "Same as clicking in Studio",
		showTouches = "Show touches",
		showTouchesHint = "Circles under your fingers",
		mouseInput = "Mouse & pen",
		mouseInputHint = "Left button acts as a finger",
		language = "Language",
		languageAuto = "Auto",

		sectionInfo = "DIAGNOSTICS",
		touchScreen = "Touch screen",
		detected = "detected",
		notDetected = "not detected",
		reset = "Reset to defaults",
	},
}

local GESTURE_KEYS = {
	rotate = "hudRotate",
	zoom = "hudZoom",
	pan = "hudPan",
	both = "hudBoth",
}

local function systemLanguage(): string
	local ids = {}
	pcall(function()
		table.insert(ids, game:GetService("StudioService").StudioLocaleId)
	end)
	pcall(function()
		table.insert(ids, game:GetService("LocalizationService").SystemLocaleId)
	end)
	for _, id in ids do
		if type(id) == "string" and string.lower(string.sub(id, 1, 2)) == "pl" then
			return "pl"
		end
	end
	return "en"
end

local Locale = {}
Locale.__index = Locale

Locale.Strings = STRINGS

function Locale.new(language: string?)
	local self = setmetatable({}, Locale)
	self:SetLanguage(language or "auto")
	return self
end

function Locale:SetLanguage(language: string)
	if language == "auto" or not STRINGS[language] then
		language = systemLanguage()
	end
	self.language = language
	self._strings = STRINGS[language]
end

function Locale:t(key: string, ...: any): string
	local text = self._strings[key] or STRINGS.en[key] or key
	if select("#", ...) > 0 then
		return string.format(text, ...)
	end
	return text
end

-- Display name of a recognizer gesture ("rotate", "zoom", "pan", "both").
function Locale:gesture(name: string?): string
	return self:t(if name then GESTURE_KEYS[name] or "noGesture" else "noGesture")
end

return Locale
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX10">
			<Properties>
				<string name="Name">Selection</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">SelectionController</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Picks objects under a screen position and updates Studio's selection.

	Mirrors Studio's click rules: locked and fully transparent parts are
	skipped, terrain is not selectable, and (optionally) clicking a part inside
	a model selects the whole top-level model.
]]

local Selection = game:GetService("Selection")
local Workspace = game:GetService("Workspace")

local Raycast = require(script.Parent.Parent.Camera.Raycast)

local function isPickable(instance: Instance): boolean
	if instance:IsA("Terrain") then
		return true -- blocks the ray, but is not selectable (handled below)
	end
	if instance:IsA("BasePart") then
		return not instance.Locked and instance.Transparency < 1
	end
	return false
end

local SelectionController = {}
SelectionController.__index = SelectionController

function SelectionController.new(settings)
	local self = setmetatable({}, SelectionController)
	self._settings = settings
	return self
end

function SelectionController:_resolve(part: Instance): Instance
	if not self._settings:Get("selectModels") then
		return part
	end
	local target = part
	local current = part.Parent
	while current and current ~= Workspace do
		if current:IsA("Model") then
			target = current
		end
		current = current.Parent
	end
	return target
end

-- Returns the object a tap at `position` would select, or nil for empty space.
function SelectionController:TargetAt(position: Vector2): Instance?
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end
	local result = Raycast.fromScreen(camera, position, isPickable)
	if not result or result.Instance:IsA("Terrain") then
		return nil
	end
	return self:_resolve(result.Instance)
end

-- Replaces the selection with whatever is under `position` (or clears it).
function SelectionController:SelectAt(position: Vector2): Instance?
	local target = self:TargetAt(position)
	Selection:Set(if target then { target } else {})
	return target
end

-- Adds or removes the object under `position`. Returns the object and whether it is now selected.
function SelectionController:ToggleAt(position: Vector2): (Instance?, boolean)
	local target = self:TargetAt(position)
	if not target then
		return nil, false
	end

	local selected = Selection:Get()
	local index = table.find(selected, target)
	if index then
		table.remove(selected, index)
	else
		table.insert(selected, target)
	end
	Selection:Set(selected)
	return target, index == nil
end

function SelectionController:Get(): { Instance }
	return Selection:Get()
end

return SelectionController
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX12">
			<Properties>
				<string name="Name">Settings</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Persistent plugin settings backed by plugin:GetSetting / plugin:SetSetting.

	`store` is anything with GetSetting/SetSetting (the plugin object in Studio,
	or nil for an in-memory store in tests).
]]

local Signal = require(script.Parent.Util.Signal)

local PREFIX = "TouchPeak_"

local DEFAULTS = {
	rotateSensitivity = 1,
	zoomSensitivity = 1,
	panSensitivity = 1,
	rotateMode = "orbit", -- "orbit" around what you look at, or "look" around in place
	inertia = true,
	combineGestures = false,
	invertRotate = false,
	invertPan = false,
	selectModels = true,
	showTouches = true,
	mouseInput = true,
	language = "auto", -- "auto" | "pl" | "en"
}

local CHOICES = {
	rotateMode = { orbit = true, look = true },
	language = { auto = true, pl = true, en = true },
}

local SENSITIVITY_RANGE = { min = 0.25, max = 3 }

local Settings = {}
Settings.__index = Settings

Settings.Defaults = DEFAULTS
Settings.SensitivityRange = SENSITIVITY_RANGE

local function sanitize(key: string, value: any): any
	local default = DEFAULTS[key]
	if value == nil or typeof(value) ~= typeof(default) then
		return default
	end
	if CHOICES[key] and not CHOICES[key][value] then
		return default
	end
	if typeof(default) == "number" then
		if value ~= value then -- NaN
			return default
		end
		return math.clamp(value, SENSITIVITY_RANGE.min, SENSITIVITY_RANGE.max)
	end
	return value
end

function Settings.new(store)
	local self = setmetatable({}, Settings)
	self._store = store
	self._values = {}
	self.Changed = Signal.new()

	for key in DEFAULTS do
		self._values[key] = sanitize(key, self:_read(key))
	end

	return self
end

function Settings:_read(key: string): any
	if not self._store then
		return nil
	end
	local ok, value = pcall(self._store.GetSetting, self._store, PREFIX .. key)
	return if ok then value else nil
end

function Settings:_write(key: string, value: any)
	if self._store then
		pcall(self._store.SetSetting, self._store, PREFIX .. key, value)
	end
end

function Settings:Get(key: string): any
	assert(DEFAULTS[key] ~= nil, `Unknown setting "{key}"`)
	return self._values[key]
end

function Settings:Set(key: string, value: any)
	assert(DEFAULTS[key] ~= nil, `Unknown setting "{key}"`)
	value = sanitize(key, value)
	if self._values[key] == value then
		return
	end
	self._values[key] = value
	self:_write(key, value)
	self.Changed:Fire(key, value)
end

function Settings:Reset()
	for key, default in DEFAULTS do
		self:Set(key, default)
	end
end

-- UI state (panel position, last tab, ...) that is remembered but is not a user preference.
function Settings:GetState(key: string): any
	return self:_read("State_" .. key)
end

function Settings:SetState(key: string, value: any)
	self:_write("State_" .. key, value)
end

return Settings
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX13">
			<Properties>
				<string name="Name">UI</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX14">
				<Properties>
					<string name="Name">Components</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Reusable, touch friendly controls. Each constructor returns a table with
	`instance` plus a `set` function to update it from code.
]]

local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)

local Color = Theme.Color
local Font = Theme.Font

local Components = {}

-- Hover (mouse) and press (mouse or touch) feedback for a button's background.
function Components.pressable(button: GuiButton, restTransparency: number, hoverTransparency: number)
	local hovering = false
	local function refresh(pressed: boolean?)
		local goal = if pressed
			then hoverTransparency - 0.04
			elseif hovering then hoverTransparency
			else restTransparency
		Create.tween(button, Theme.Tween.Fast, { BackgroundTransparency = goal })
	end
	button.MouseEnter:Connect(function()
		hovering = true
		refresh()
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		refresh()
	end)
	button.InputBegan:Connect(function(input)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			refresh(true)
		end
	end)
	button.InputEnded:Connect(function(input)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			if inputType == Enum.UserInputType.Touch then
				hovering = false
			end
			refresh()
		end
	end)
end

-- Small square button with a vector glyph inside (built from frames, no images needed).
function Components.IconButton(props: { glyph: GuiObject, onActivated: () -> () })
	local button = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = Color.White,
		BackgroundTransparency = 0.95,
		ZIndex = 3,
	}, {
		Create.corner(10),
		Glyph = props.glyph,
	})
	Components.pressable(button, 0.95, 0.86)
	button.Activated:Connect(props.onActivated)
	return { instance = button }
end

local function bar(width: number, height: number, rotation: number, position: UDim2?): Frame
	return Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		Rotation = rotation,
		BackgroundColor3 = Color.Text,
	}, { Create.round() })
end

function Components.CloseGlyph(): Frame
	return Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
	}, {
		A = bar(14, 2, 45),
		B = bar(14, 2, -45),
	})
end

-- An upward chevron; rotate the returned frame 180 degrees to point it down.
function Components.ChevronGlyph(): Frame
	return Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
	}, {
		Left = bar(9, 2, -45, UDim2.new(0.5, -3, 0.5, 0)),
		Right = bar(9, 2, 45, UDim2.new(0.5, 3, 0.5, 0)),
	})
end

function Components.Toggle(props: { value: boolean, onChanged: (boolean) -> () })
	local value = props.value

	local fill = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color.White,
		BackgroundTransparency = if value then 0 else 1,
	}, {
		Create.round(),
		Create.accentGradient(),
	})

	local knob = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, if value then 23 else 3, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Color.White,
		ZIndex = 2,
	}, { Create.round() })

	local track = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(46, 26),
		BackgroundColor3 = Color.SurfaceHover,
		BackgroundTransparency = 0,
	}, {
		Create.round(),
		Fill = fill,
		Knob = knob,
	})

	local api = { instance = track }

	function api.set(newValue: boolean, instant: boolean?)
		value = newValue
		local info = if instant then nil else Theme.Tween.Smooth
		Create.animate(fill, info, { BackgroundTransparency = if value then 0 else 1 })
		Create.animate(knob, info, { Position = UDim2.new(0, if value then 23 else 3, 0.5, 0) })
	end

	track.Activated:Connect(function()
		api.set(not value)
		props.onChanged(value)
	end)

	return api
end

local function formatMultiplier(value: number): string
	local text = string.format("%.2f", value)
	text = string.gsub(text, "0$", "")
	return text .. "×"
end

function Components.Stepper(props: {
	value: number,
	min: number,
	max: number,
	step: number,
	onChanged: (number) -> (),
})
	local value = props.value

	local function stepButton(isPlus: boolean, position: UDim2, anchor: Vector2)
		local glyph = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
		}, {
			H = bar(11, 2, 0),
			V = if isPlus then bar(2, 11, 0) else nil,
		})
		local button = Create("TextButton", {
			AnchorPoint = anchor,
			Position = position,
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Color.White,
			BackgroundTransparency = 0.96,
		}, {
			Create.corner(9),
			Glyph = glyph,
		})
		Components.pressable(button, 0.96, 0.88)
		return button
	end

	local label = Create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -64, 1, 0),
		FontFace = Font.Bold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = formatMultiplier(value),
	})

	local minus = stepButton(false, UDim2.fromScale(0, 0.5), Vector2.new(0, 0.5))
	local plus = stepButton(true, UDim2.fromScale(1, 0.5), Vector2.new(1, 0.5))

	local container = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(112, 30),
		BackgroundColor3 = Color.SurfaceHigh,
	}, {
		Create.corner(9),
		Minus = minus,
		Plus = plus,
		Value = label,
	})

	local api = { instance = container }

	function api.set(newValue: number)
		value = math.clamp(newValue, props.min, props.max)
		label.Text = formatMultiplier(value)
		minus.Glyph.H.BackgroundTransparency = if value <= props.min then 0.7 else 0
		plus.Glyph.H.BackgroundTransparency = if value >= props.max then 0.7 else 0
		plus.Glyph.V.BackgroundTransparency = if value >= props.max then 0.7 else 0
	end

	local function change(direction: number)
		local newValue = math.clamp(value + direction * props.step, props.min, props.max)
		-- Avoid floating point drift (0.1 + 0.2 ...).
		newValue = math.round(newValue / props.step) * props.step
		if newValue ~= value then
			api.set(newValue)
			props.onChanged(value)
		end
	end

	minus.Activated:Connect(function()
		change(-1)
	end)
	plus.Activated:Connect(function()
		change(1)
	end)

	api.set(value)
	return api
end

-- Pill-shaped segmented control with a sliding gradient highlight.
function Components.Segmented(props: {
	options: { { id: string, label: string } },
	value: string,
	onChanged: (string) -> (),
	size: UDim2?,
	textSize: number?,
})
	local count = #props.options
	local value = props.value

	local highlight = Create("Frame", {
		Size = UDim2.new(1 / count, -4, 1, -4),
		BackgroundColor3 = Color.White,
	}, {
		Create.corner(8),
		Create.accentGradient(),
	})

	local container = Create("Frame", {
		Size = props.size or UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Color.SurfaceHigh,
	}, {
		Create.corner(10),
		Highlight = highlight,
	})

	local api = { instance = container }
	local buttons = {}

	function api.set(id: string, instant: boolean?)
		local entry = buttons[id]
		if not entry then
			return
		end
		value = id
		local info = if instant then nil else Theme.Tween.Smooth
		Create.animate(highlight, info, {
			Position = UDim2.new((entry.index - 1) / count, 2, 0, 2),
		})
		for optionId, other in buttons do
			Create.animate(other.button, info, {
				TextColor3 = if optionId == id then Color.White else Color.TextDim,
			})
		end
	end

	for index, option in props.options do
		local button = Create("TextButton", {
			Position = UDim2.fromScale((index - 1) / count, 0),
			Size = UDim2.fromScale(1 / count, 1),
			Text = option.label,
			FontFace = Font.Bold,
			TextSize = props.textSize or 14,
			TextColor3 = Color.TextDim,
			ZIndex = 2,
			Parent = container,
		})
		buttons[option.id] = { button = button, index = index }
		button.Activated:Connect(function()
			if value ~= option.id then
				api.set(option.id)
				props.onChanged(option.id)
			end
		end)
	end

	api.set(value, true)
	return api
end

function Components.SectionLabel(text: string, layoutOrder: number): TextLabel
	return Create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 26),
		Text = text,
		FontFace = Font.Bold,
		TextSize = 11,
		TextColor3 = Color.TextFaint,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = layoutOrder,
	}, {
		Create.padding(0, 4, 4, 4),
	})
end

-- A card with a title, optional hint and a control on the right.
function Components.Row(props: {
	title: string,
	hint: string?,
	control: GuiObject?,
	controlWidth: number?,
	layoutOrder: number,
})
	local hasHint = props.hint ~= nil
	local reserved = (props.controlWidth or 0) + 10

	local row = Create("Frame", {
		Size = UDim2.new(1, 0, 0, if hasHint then 54 else 44),
		BackgroundColor3 = Color.Surface,
		LayoutOrder = props.layoutOrder,
	}, {
		Create.corner(12),
		Create.stroke(Color.White, 0.95),
		Create.padding(0, 12),
		Title = Create("TextLabel", {
			Position = UDim2.fromOffset(0, if hasHint then 9 else 0),
			Size = UDim2.new(1, -reserved, 0, if hasHint then 20 else 44),
			Text = props.title,
			FontFace = Font.SemiBold,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}),
		Hint = if hasHint
			then Create("TextLabel", {
				Position = UDim2.fromOffset(0, 29),
				Size = UDim2.new(1, -reserved, 0, 16),
				Text = props.hint,
				FontFace = Font.Regular,
				TextSize = 12,
				TextColor3 = Color.TextDim,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			else nil,
	})

	if props.control then
		props.control.AnchorPoint = Vector2.new(1, 0.5)
		props.control.Position = UDim2.fromScale(1, 0.5)
		props.control.Parent = row
	end

	return row
end

-- Wide secondary button.
function Components.Button(props: { text: string, layoutOrder: number, onActivated: () -> () })
	local button = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Color.White,
		BackgroundTransparency = 0.95,
		Text = props.text,
		FontFace = Font.SemiBold,
		TextSize = 14,
		TextColor3 = Color.Text,
		LayoutOrder = props.layoutOrder,
	}, {
		Create.corner(12),
		Create.stroke(Color.White, 0.9),
	})
	Components.pressable(button, 0.95, 0.88)
	button.Activated:Connect(props.onActivated)
	return { instance = button }
end

-- Small rounded label used for live readouts ("Fingers 2").
function Components.Chip(layoutOrder: number)
	local label = Create("TextLabel", {
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color.SurfaceHigh,
		BackgroundTransparency = 0,
		FontFace = Font.Medium,
		TextSize = 12,
		TextColor3 = Color.TextDim,
		RichText = true,
		LayoutOrder = layoutOrder,
	}, {
		Create.corner(7),
		Create.padding(0, 8),
	})
	return label
end

return Components
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX15">
				<Properties>
					<string name="Name">Create</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Tiny declarative instance builder:

		Create("Frame", { Size = ... }, {
			Create.corner(12),
			Label = Create("TextLabel", { Text = "Hi" }),
		})

	String keys in the children table become the child's Name.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local DEFAULTS = {
	Frame = { BorderSizePixel = 0 },
	ScrollingFrame = {
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Color.White,
		ScrollBarImageTransparency = 0.75,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ElasticBehavior = Enum.ElasticBehavior.Always,
	},
	TextLabel = {
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		FontFace = Theme.Font.Medium,
		TextColor3 = Theme.Color.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	},
	TextButton = {
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		FontFace = Theme.Font.SemiBold,
		TextColor3 = Theme.Color.Text,
		TextSize = 14,
		Text = "",
	},
}

local Create = {}

local function create(className: string, props: { [string]: any }?, children: { [any]: Instance }?): Instance
	local instance = Instance.new(className)

	local defaults = DEFAULTS[className]
	if defaults then
		for key, value in defaults do
			instance[key] = value
		end
	end

	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end

	for key, child in children or {} do
		if type(key) == "string" then
			child.Name = key
		end
		child.Parent = instance
	end

	if parent then
		instance.Parent = parent
	end
	return instance
end

setmetatable(Create, {
	__call = function(_, className, props, children)
		return create(className, props, children)
	end,
})

function Create.corner(radius: number): UICorner
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function Create.round(): UICorner
	return create("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function Create.stroke(color: Color3?, transparency: number?, thickness: number?): UIStroke
	return create("UIStroke", {
		Color = color or Theme.Color.White,
		Transparency = transparency or 0.9,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Create.padding(top: number, right: number?, bottom: number?, left: number?): UIPadding
	right = right or top
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom or top),
		PaddingLeft = UDim.new(0, left or right),
	})
end

function Create.list(padding: number, direction: Enum.FillDirection?): UIListLayout
	return create("UIListLayout", {
		Padding = UDim.new(0, padding),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	})
end

function Create.accentGradient(rotation: number?): UIGradient
	return create("UIGradient", { Color = Theme.AccentGradient, Rotation = rotation or 0 })
end

-- A filled circle centred on `position`.
function Create.dot(size: number, color: Color3, position: UDim2?): Frame
	return create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color,
	}, { Create.round() })
end

-- An outlined circle centred on `position`.
function Create.ring(size: number, color: Color3, transparency: number, thickness: number, position: UDim2?): Frame
	return create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	}, {
		Create.round(),
		Stroke = Create.stroke(color, transparency, thickness),
	})
end

function Create.tween(instance: Instance, info: TweenInfo, goal: { [string]: any }): Tween
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

-- Tweens to `goal`, or applies it immediately when `info` is nil.
function Create.animate(instance: Instance, info: TweenInfo?, goal: { [string]: any })
	if info then
		Create.tween(instance, info, goal)
	else
		for key, value in goal do
			instance[key] = value
		end
	end
end

return Create
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX16">
				<Properties>
					<string name="Name">GestureIcons</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Small animated illustrations of each gesture, drawn with frames only.

	Every builder returns the icon frame and a list of looping tweens. The
	tweens are created paused; the panel plays them only while visible.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)

local Color = Theme.Color

local FINGER = 9 -- finger dot size

-- A tween that repeats forever (optionally bouncing back and forth).
local function loop(instance: Instance, duration: number, goal, style: Enum.EasingStyle?, reverses: boolean?): Tween
	local info =
		TweenInfo.new(duration, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, reverses == true)
	return TweenService:Create(instance, info, goal)
end

local function canvas(): Frame
	return Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	})
end

local function finger(position: UDim2?): Frame
	return Create.dot(FINGER, Color.Accent, position)
end

local function ghost(position: UDim2): Frame
	local dot = Create.dot(FINGER, Color.White, position)
	dot.BackgroundTransparency = 0.82
	return dot
end

local Icons = {}

-- One finger orbiting around a faint circle.
function Icons.rotate()
	local spinner = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, {
		Finger = finger(UDim2.new(0.5, 0, 0.5, -11)),
	})
	local icon = canvas()
	Create.ring(22, Color.White, 0.75, 1.5).Parent = icon
	spinner.Parent = icon

	local tweens = {
		loop(spinner, 2.4, { Rotation = 360 }, Enum.EasingStyle.Linear),
	}
	return icon, tweens
end

-- Two fingers moving apart and back together along a diagonal.
function Icons.zoom()
	local icon = canvas()
	Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(28, 2),
		Rotation = -45,
		BackgroundColor3 = Color.White,
		BackgroundTransparency = 0.8,
		Parent = icon,
	})
	local a = finger(UDim2.fromScale(0.4, 0.6))
	local b = finger(UDim2.fromScale(0.6, 0.4))
	a.Parent = icon
	b.Parent = icon

	local tweens = {
		loop(a, 0.9, { Position = UDim2.fromScale(0.22, 0.78) }, nil, true),
		loop(b, 0.9, { Position = UDim2.fromScale(0.78, 0.22) }, nil, true),
	}
	return icon, tweens
end

-- Two fingers sliding sideways together.
function Icons.pan()
	local icon = canvas()
	ghost(UDim2.fromScale(0.28, 0.36)).Parent = icon
	ghost(UDim2.fromScale(0.28, 0.64)).Parent = icon
	local a = finger(UDim2.fromScale(0.28, 0.36))
	local b = finger(UDim2.fromScale(0.28, 0.64))
	a.Parent = icon
	b.Parent = icon

	local tweens = {
		loop(a, 1.1, { Position = UDim2.fromScale(0.72, 0.36) }, Enum.EasingStyle.Quad, true),
		loop(b, 1.1, { Position = UDim2.fromScale(0.72, 0.64) }, Enum.EasingStyle.Quad, true),
	}
	return icon, tweens
end

local function rippleIcon(period: number, badge: string?)
	local icon = canvas()
	local ring = Create.ring(FINGER, Color.Accent, 0.1, 2)
	ring.Parent = icon
	finger().Parent = icon

	if badge then
		Create("TextLabel", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, 1, 1, 2),
			Size = UDim2.fromOffset(18, 12),
			Text = badge,
			FontFace = Theme.Font.ExtraBold,
			TextSize = 11,
			TextColor3 = Color.Text,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = icon,
		})
	end

	local info = TweenInfo.new(period, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, false, 0.25)
	local tweens = {
		TweenService:Create(ring, info, { Size = UDim2.fromOffset(30, 30) }),
		TweenService:Create(ring.Stroke, info, { Transparency = 1 }),
	}
	return icon, tweens
end

-- A finger with a ripple spreading out.
function Icons.tap()
	return rippleIcon(0.9)
end

-- Faster ripple with a "2×" badge.
function Icons.doubleTap()
	return rippleIcon(0.5, "2×")
end

-- A finger pressing down while a ring fills in.
function Icons.longPress()
	local icon = canvas()
	local ring = Create.ring(26, Color.Accent, 0.9, 2)
	ring.Parent = icon
	local dot = finger()
	dot.Parent = icon
	local scale = Create("UIScale", { Parent = dot })

	local tweens = {
		loop(ring.Stroke, 1.1, { Transparency = 0.05 }, nil, true),
		loop(scale, 1.1, { Scale = 0.7 }, nil, true),
	}
	return icon, tweens
end

return Icons
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX17">
				<Properties>
					<string name="Name">Overlay</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Viewport feedback drawn on top of the 3D view:
	  * glowing circles under each finger (and a line joining two fingers),
	  * a ripple where you tap,
	  * a pill at the bottom naming the current gesture,
	  * short toasts at the top ("Selected: Part").
]]

local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)
local Maid = require(script.Parent.Parent.Util.Maid)

local Color = Theme.Color
local Font = Theme.Font

local TOUCH_SIZE = 58
local TOAST_TIME = 1.6

local Overlay = {}
Overlay.__index = Overlay

-- A pill with a coloured dot and a label that can fade in and out.
local function makePill(parent: Instance, anchor: Vector2, position: UDim2)
	local dot = Create.dot(8, Color.Accent, UDim2.new(0, 0, 0.5, 0))
	dot.AnchorPoint = Vector2.new(0, 0.5)
	dot.BackgroundTransparency = 1

	local label = Create("TextLabel", {
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		FontFace = Font.SemiBold,
		TextSize = 14,
		TextTransparency = 1,
	})

	local stroke = Create.stroke(Color.White, 1)
	local scale = Create("UIScale", { Scale = 0.9 })

	local pill = Create("Frame", {
		AnchorPoint = anchor,
		Position = position,
		Size = UDim2.fromOffset(0, 38),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color.Background,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = parent,
	}, {
		Create.round(),
		Create.padding(0, 16),
		Stroke = stroke,
		Scale = scale,
		Content = Create("Frame", {
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
		}, {
			Dot = dot,
			Label = label,
		}),
	})

	local api = {}
	local token = 0

	function api.show(text: string, color: Color3?)
		token += 1
		label.Text = text
		dot.BackgroundColor3 = color or Color.Accent
		pill.Visible = true
		Create.tween(pill, Theme.Tween.Fast, { BackgroundTransparency = 0.08 })
		Create.tween(stroke, Theme.Tween.Fast, { Transparency = 0.85 })
		Create.tween(label, Theme.Tween.Fast, { TextTransparency = 0 })
		Create.tween(dot, Theme.Tween.Fast, { BackgroundTransparency = 0 })
		Create.tween(scale, Theme.Tween.Spring, { Scale = 1 })
	end

	function api.hide()
		token += 1
		local myToken = token
		Create.tween(pill, Theme.Tween.Smooth, { BackgroundTransparency = 1 })
		Create.tween(stroke, Theme.Tween.Smooth, { Transparency = 1 })
		Create.tween(label, Theme.Tween.Smooth, { TextTransparency = 1 })
		Create.tween(dot, Theme.Tween.Smooth, { BackgroundTransparency = 1 })
		Create.tween(scale, Theme.Tween.Smooth, { Scale = 0.9 })
		task.delay(Theme.Tween.Smooth.Time, function()
			if token == myToken then
				pill.Visible = false
			end
		end)
	end

	function api.flash(text: string, color: Color3?, duration: number)
		api.show(text, color)
		local myToken = token
		task.delay(duration, function()
			if token == myToken then
				api.hide()
			end
		end)
	end

	return api
end

function Overlay.new(parent: Instance, settings)
	local self = setmetatable({}, Overlay)
	self._settings = settings
	self._maid = Maid.new()
	self._touches = {} -- id -> { frame, position }

	self._root = self._maid:Give(Create("Frame", {
		Name = "TouchPeakOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = parent,
	}))

	self._link = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(0, 3),
		BackgroundColor3 = Color.White,
		BackgroundTransparency = 0.35,
		Visible = false,
		Parent = self._root,
	}, {
		Create.round(),
		Create.accentGradient(),
	})

	self._gesturePill = makePill(self._root, Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -26))
	self._toast = makePill(self._root, Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 18))

	return self
end

-- Finger circles -----------------------------------------------------------------

function Overlay:TouchBegan(id: any, position: Vector2)
	if not self._settings:Get("showTouches") or self._touches[id] then
		return
	end

	local scale = Create("UIScale", { Scale = 0.4 })
	local frame = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(position.X, position.Y),
		Size = UDim2.fromOffset(TOUCH_SIZE, TOUCH_SIZE),
		BackgroundColor3 = Color.Accent,
		BackgroundTransparency = 0.82,
		ZIndex = 2,
		Parent = self._root,
	}, {
		Create.round(),
		Stroke = Create.stroke(Color.Accent, 0.1, 2),
		Core = Create.dot(14, Color.White),
		Scale = scale,
	})
	Create.tween(scale, Theme.Tween.Spring, { Scale = 1 })

	self._touches[id] = { frame = frame, position = position }
	self:_updateLink()
end

function Overlay:TouchMoved(id: any, position: Vector2)
	local touch = self._touches[id]
	if not touch then
		return
	end
	touch.position = position
	touch.frame.Position = UDim2.fromOffset(position.X, position.Y)
	self:_updateLink()
end

function Overlay:TouchEnded(id: any)
	local touch = self._touches[id]
	if not touch then
		return
	end
	self._touches[id] = nil
	self:_updateLink()

	local frame = touch.frame
	Create.tween(frame.Scale, Theme.Tween.Smooth, { Scale = 1.35 })
	Create.tween(frame, Theme.Tween.Smooth, { BackgroundTransparency = 1 })
	Create.tween(frame.Stroke, Theme.Tween.Smooth, { Transparency = 1 })
	Create.tween(frame.Core, Theme.Tween.Smooth, { BackgroundTransparency = 1 })
	task.delay(Theme.Tween.Smooth.Time, function()
		frame:Destroy()
	end)
end

function Overlay:_updateLink()
	local points = {}
	for _, touch in self._touches do
		table.insert(points, touch.position)
	end

	if #points ~= 2 then
		self._link.Visible = false
		return
	end

	local a, b = points[1], points[2]
	local offset = b - a
	local middle = (a + b) / 2
	self._link.Visible = true
	self._link.Position = UDim2.fromOffset(middle.X, middle.Y)
	self._link.Size = UDim2.fromOffset(offset.Magnitude, 3)
	self._link.Rotation = math.deg(math.atan2(offset.Y, offset.X))
end

-- Expanding ring where a tap landed.
function Overlay:Ripple(position: Vector2, color: Color3?)
	if not self._settings:Get("showTouches") then
		return
	end
	local ring = Create.ring(16, color or Color.Accent, 0, 3, UDim2.fromOffset(position.X, position.Y))
	ring.ZIndex = 2
	ring.Parent = self._root

	local info = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Create.tween(ring, info, { Size = UDim2.fromOffset(76, 76) })
	Create.tween(ring.Stroke, info, { Transparency = 1 })
	task.delay(info.Time, function()
		ring:Destroy()
	end)
end

-- Feedback pills -----------------------------------------------------------------

function Overlay:ShowGesture(text: string?)
	if text then
		self._gesturePill.show(text, Color.Accent)
	else
		self._gesturePill.hide()
	end
end

function Overlay:Toast(text: string, color: Color3?)
	self._toast.flash(text, color, TOAST_TIME)
end

function Overlay:ClearTouches()
	for id in table.clone(self._touches) do
		self:TouchEnded(id)
	end
end

function Overlay:Destroy()
	self._touches = {}
	self._maid:Clean()
end

return Overlay
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX18">
				<Properties>
					<string name="Name">Panel</string>
					<ProtectedString name="Source"><![CDATA[--[[
	The floating Touch Peak window drawn over the viewport.

	  * The header is a drag handle (mouse or finger) and shows whether touch
	    controls are active, with a pulsing status dot.
	  * The chevron collapses the window into a compact pill; tapping the pill
	    expands it again.
	  * "Gestures" lists every control with a small animation, "Settings"
	    holds sensitivities and options.
]]

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Config = require(script.Parent.Parent.Config)
local Maid = require(script.Parent.Parent.Util.Maid)
local Settings = require(script.Parent.Parent.Settings)
local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)
local Components = require(script.Parent.Components)
local GestureIcons = require(script.Parent.GestureIcons)

local Color = Theme.Color
local Font = Theme.Font
local Size = Theme.Size

local DRAG_THRESHOLD = 6
local HEADER_BUTTONS_WIDTH = 100
local PAGES_TOP = 142
local FOOTER_HEIGHT = 34

local GESTURES = {
	{ icon = "rotate", title = "gestureRotate", hint = "gestureRotateHint" },
	{ icon = "zoom", title = "gestureZoom", hint = "gestureZoomHint" },
	{ icon = "pan", title = "gesturePan", hint = "gesturePanHint" },
	{ icon = "tap", title = "gestureTap", hint = "gestureTapHint" },
	{ icon = "doubleTap", title = "gestureDoubleTap", hint = "gestureDoubleTapHint" },
	{ icon = "longPress", title = "gestureLongPress", hint = "gestureLongPressHint" },
}

local function toVector2(position: Vector3): Vector2
	return Vector2.new(position.X, position.Y)
end

local function isPointer(input: InputObject): boolean
	local inputType = input.UserInputType
	return inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch
end

local Panel = {}
Panel.__index = Panel

export type Params = {
	parent: GuiBase2d,
	settings: any,
	locale: any,
	active: boolean,
	touchDetected: boolean,
	onActiveChanged: (boolean) -> (),
	onClose: () -> (),
}

function Panel.new(params: Params)
	local self = setmetatable({}, Panel)
	self._params = params
	self._settings = params.settings
	self._locale = params.locale
	self._maid = Maid.new()
	self._loops = {}
	self._controls = {}
	self._visible = false
	self._visibleToken = 0
	self._collapseToken = 0
	self._collapsed = false
	self._active = params.active
	self._touchCount = 0
	self._gesture = nil
	self._drag = nil
	self._tab = if self._settings:GetState("tab") == "settings" then "settings" else "gestures"

	self:_build()
	self:_buildGesturesPage()
	self:_buildSettingsPage()
	self:_bindDrag()
	self:_restorePosition()
	self:_selectTab(self._tab, true)
	self:SetTouchDetected(params.touchDetected)
	self:SetActive(params.active, true)
	self:_refreshChips()

	self._maid:Give(params.parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if not self._customPosition then
			self._position = self:_defaultPosition()
		end
		self:_applyLayout(true)
	end))
	self._maid:Give(self._settings.Changed:Connect(function(key, value)
		local control = self._controls[key]
		if control then
			control.set(value)
		end
	end))

	return self
end

function Panel:_t(key: string, ...: any): string
	return self._locale:t(key, ...)
end

-- Construction -------------------------------------------------------------------

function Panel:_build()
	-- Header ------------------------------------------------------------------
	local logo = Create("Frame", {
		Position = UDim2.fromOffset(14, 13),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = Color.White,
	}, {
		Create.corner(11),
		Create.accentGradient(45),
		Ring = Create.ring(20, Color.White, 0.3, 2),
		Dot = Create.dot(8, Color.White),
	})

	local statusPulse = Create.dot(8, Color.Success, UDim2.new(0, 4, 0.5, 0))
	statusPulse.BackgroundTransparency = 0.4
	statusPulse.ZIndex = 1
	local statusDot = Create.dot(8, Color.Success, UDim2.new(0, 4, 0.5, 0))
	statusDot.ZIndex = 2
	local statusLabel = Create("TextLabel", {
		Position = UDim2.fromOffset(15, 0),
		Size = UDim2.new(1, -15, 1, 0),
		FontFace = Font.SemiBold,
		TextSize = 12,
		TextColor3 = Color.Success,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local chevron = Components.ChevronGlyph()
	local collapseButton = Components.IconButton({
		glyph = chevron,
		onActivated = function()
			self:SetCollapsed(not self._collapsed)
		end,
	})
	collapseButton.instance.Position = UDim2.new(1, -54, 0.5, 0)

	local closeButton = Components.IconButton({
		glyph = Components.CloseGlyph(),
		onActivated = function()
			self._params.onClose()
		end,
	})
	closeButton.instance.Position = UDim2.new(1, -14, 0.5, 0)

	local dragHandle = Create("TextButton", {
		Size = UDim2.new(1, -HEADER_BUTTONS_WIDTH, 1, 0),
		ZIndex = 2,
	})

	local header = Create("Frame", {
		Size = UDim2.new(1, 0, 0, Size.Header),
		BackgroundTransparency = 1,
		ZIndex = 2,
	}, {
		Logo = logo,
		Title = Create("TextLabel", {
			Position = UDim2.fromOffset(62, 12),
			Size = UDim2.new(1, -62 - HEADER_BUTTONS_WIDTH + 8, 0, 20),
			Text = Config.ToolbarName,
			FontFace = Font.ExtraBold,
			TextSize = 17,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}),
		Status = Create("Frame", {
			Position = UDim2.fromOffset(62, 34),
			Size = UDim2.new(1, -62 - HEADER_BUTTONS_WIDTH + 8, 0, 16),
			BackgroundTransparency = 1,
		}, {
			Pulse = statusPulse,
			Dot = statusDot,
			Label = statusLabel,
		}),
		DragHandle = dragHandle,
		Collapse = collapseButton.instance,
		Close = closeButton.instance,
	})

	-- Status card ---------------------------------------------------------------
	local toggle = Components.Toggle({
		value = self._active,
		onChanged = function(value)
			self._params.onActiveChanged(value)
		end,
	})
	toggle.instance.Position = UDim2.new(1, -14, 0.5, 0)

	local fingersChip = Components.Chip(1)
	local gestureChip = Components.Chip(2)

	local statusCard = Create("Frame", {
		Position = UDim2.fromOffset(Size.Padding, 12),
		Size = UDim2.new(1, -Size.Padding * 2, 0, 72),
		BackgroundColor3 = Color.Surface,
	}, {
		Create.corner(14),
		Create.stroke(Color.White, 0.93),
		Title = Create("TextLabel", {
			Position = UDim2.fromOffset(14, 12),
			Size = UDim2.new(1, -84, 0, 20),
			Text = self:_t("touchControl"),
			FontFace = Font.Bold,
			TextSize = 15,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}),
		Chips = Create("Frame", {
			Position = UDim2.fromOffset(14, 38),
			Size = UDim2.new(1, -84, 0, 22),
			BackgroundTransparency = 1,
		}, {
			Create.list(6, Enum.FillDirection.Horizontal),
			Fingers = fingersChip,
			Gesture = gestureChip,
		}),
		Toggle = toggle.instance,
	})

	-- Tabs and pages -----------------------------------------------------------
	local tabs = Components.Segmented({
		options = {
			{ id = "gestures", label = self:_t("tabGestures") },
			{ id = "settings", label = self:_t("tabSettings") },
		},
		value = self._tab,
		size = UDim2.new(1, -Size.Padding * 2, 0, 36),
		onChanged = function(id)
			self:_selectTab(id)
		end,
	})
	tabs.instance.Position = UDim2.fromOffset(Size.Padding, 96)

	local function page(): ScrollingFrame
		return Create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
		}, {
			Create.padding(2, Size.Padding, 14, Size.Padding),
			Create.list(6),
		})
	end
	local gesturesPage = page()
	local settingsPage = page()

	local pages = Create("Frame", {
		Position = UDim2.fromOffset(0, PAGES_TOP),
		Size = UDim2.new(1, 0, 1, -PAGES_TOP - FOOTER_HEIGHT),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, {
		Gestures = gesturesPage,
		Settings = settingsPage,
	})

	local footer = Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, Size.Padding, 1, 0),
		Size = UDim2.new(1, -Size.Padding * 2, 0, FOOTER_HEIGHT),
		BackgroundTransparency = 1,
	}, {
		Divider = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Color.White,
			BackgroundTransparency = 0.93,
		}),
		Hint = Create("TextLabel", {
			Size = UDim2.new(1, -56, 1, 0),
			Text = self:_t("dragHint"),
			FontFace = Font.Regular,
			TextSize = 11,
			TextColor3 = Color.TextFaint,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}),
		Version = Create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, 56, 1, 0),
			Text = "v" .. Config.Version,
			FontFace = Font.SemiBold,
			TextSize = 11,
			TextColor3 = Color.TextFaint,
			TextXAlignment = Enum.TextXAlignment.Right,
		}),
	})

	local content = Create("Frame", {
		Position = UDim2.fromOffset(0, Size.Header),
		Size = UDim2.new(1, 0, 1, -Size.Header),
		BackgroundTransparency = 1,
	}, {
		Divider = Create("Frame", {
			Position = UDim2.fromOffset(Size.Padding, 0),
			Size = UDim2.new(1, -Size.Padding * 2, 0, 1),
			BackgroundColor3 = Color.White,
			BackgroundTransparency = 0.93,
		}),
		StatusCard = statusCard,
		Tabs = tabs.instance,
		Pages = pages,
		Footer = footer,
	})

	-- Body, shadow and root ----------------------------------------------------------
	local body = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color.Background,
		BackgroundTransparency = 0.03,
		ClipsDescendants = true,
		ZIndex = 2,
	}, {
		Create.corner(18),
		Create.stroke(Color.White, 0.87),
		Glow = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 160),
			BackgroundColor3 = Color.White,
		}, {
			Create.corner(18),
			Create("UIGradient", {
				Color = Theme.AccentGradient,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.83),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rotation = 90,
			}),
		}),
		Header = header,
		Content = content,
	})

	local scale = Create("UIScale", { Scale = 1 })
	local root = Create("Frame", {
		Name = "TouchPeakPanel",
		Size = UDim2.fromOffset(Size.PanelWidth, Size.PanelHeight),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
	}, {
		Scale = scale,
		Body = body,
	})

	-- Soft shadow: several very faint layers, each a little larger than the last.
	for index, layer in { { 2, 0.9 }, { 6, 0.94 }, { 12, 0.965 }, { 20, 0.98 } } do
		local spread, transparency = layer[1], layer[2]
		Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 2 + index),
			Size = UDim2.new(1, spread, 1, spread),
			BackgroundColor3 = Color.Black,
			BackgroundTransparency = transparency,
			ZIndex = 1,
			Parent = root,
		}, { Create.corner(18 + spread / 2) })
	end

	root.Parent = self._params.parent
	self._maid:Give(root)

	self._pulseTween = TweenService:Create(
		statusPulse,
		TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1),
		{ Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1 }
	)
	self._maid:Give(self._pulseTween)

	self._root = root
	self._scale = scale
	self._body = body
	self._content = content
	self._chevron = chevron
	self._dragHandle = dragHandle
	self._statusDot = statusDot
	self._statusPulse = statusPulse
	self._statusLabel = statusLabel
	self._toggle = toggle
	self._fingersChip = fingersChip
	self._gestureChip = gestureChip
	self._tabs = tabs
	self._gesturesPage = gesturesPage
	self._settingsPage = settingsPage
end

function Panel:_buildGesturesPage()
	for index, gesture in GESTURES do
		local icon, tweens = GestureIcons[gesture.icon]()
		for _, tween in tweens do
			table.insert(self._loops, tween)
			self._maid:Give(tween)
		end

		Create("Frame", {
			Size = UDim2.new(1, 0, 0, 52),
			BackgroundColor3 = Color.Surface,
			LayoutOrder = index,
			Parent = self._gesturesPage,
		}, {
			Create.corner(13),
			Create.stroke(Color.White, 0.95),
			IconBox = Create("Frame", {
				Position = UDim2.fromOffset(7, 7),
				Size = UDim2.fromOffset(38, 38),
				BackgroundColor3 = Color.SurfaceHigh,
			}, {
				Create.corner(10),
				Icon = icon,
			}),
			Title = Create("TextLabel", {
				Position = UDim2.fromOffset(56, 8),
				Size = UDim2.new(1, -66, 0, 19),
				Text = self:_t(gesture.title),
				FontFace = Font.SemiBold,
				TextSize = 14,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}),
			Hint = Create("TextLabel", {
				Position = UDim2.fromOffset(56, 27),
				Size = UDim2.new(1, -66, 0, 16),
				Text = self:_t(gesture.hint),
				FontFace = Font.Regular,
				TextSize = 12,
				TextColor3 = Color.TextDim,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}),
		})
	end
end

function Panel:_buildSettingsPage()
	local settings = self._settings
	local page = self._settingsPage
	local order = 0

	local function add(instance: GuiObject)
		order += 1
		instance.LayoutOrder = order
		instance.Parent = page
	end

	local function section(key: string)
		add(Components.SectionLabel(self:_t(key), 0))
	end

	local function stepper(key: string, title: string)
		local control = Components.Stepper({
			value = settings:Get(key),
			min = Settings.SensitivityRange.min,
			max = Settings.SensitivityRange.max,
			step = 0.25,
			onChanged = function(value)
				settings:Set(key, value)
			end,
		})
		self._controls[key] = control
		add(Components.Row({ title = self:_t(title), control = control.instance, controlWidth = 112, layoutOrder = 0 }))
	end

	local function toggle(key: string, title: string, hint: string?)
		local control = Components.Toggle({
			value = settings:Get(key),
			onChanged = function(value)
				settings:Set(key, value)
			end,
		})
		self._controls[key] = control
		add(Components.Row({
			title = self:_t(title),
			hint = if hint then self:_t(hint) else nil,
			control = control.instance,
			controlWidth = 46,
			layoutOrder = 0,
		}))
	end

	local function choice(key: string, title: string, options, width: number)
		local control = Components.Segmented({
			options = options,
			value = settings:Get(key),
			size = UDim2.fromOffset(width, 30),
			textSize = 12,
			onChanged = function(id)
				settings:Set(key, id)
			end,
		})
		self._controls[key] = control
		add(
			Components.Row({ title = self:_t(title), control = control.instance, controlWidth = width, layoutOrder = 0 })
		)
	end

	section("sectionSensitivity")
	stepper("rotateSensitivity", "rotateSpeed")
	stepper("zoomSensitivity", "zoomSpeed")
	stepper("panSensitivity", "panSpeed")

	section("sectionCamera")
	choice("rotateMode", "rotateMode", {
		{ id = "orbit", label = self:_t("rotateModeOrbit") },
		{ id = "look", label = self:_t("rotateModeLook") },
	}, 150)
	toggle("inertia", "inertia", "inertiaHint")
	toggle("combineGestures", "combineGestures", "combineGesturesHint")
	toggle("invertRotate", "invertRotate", "invertRotateHint")
	toggle("invertPan", "invertPan", "invertPanHint")

	section("sectionSelection")
	toggle("selectModels", "selectModels", "selectModelsHint")
	toggle("showTouches", "showTouches", "showTouchesHint")
	toggle("mouseInput", "mouseInput", "mouseInputHint")
	choice("language", "language", {
		{ id = "auto", label = self:_t("languageAuto") },
		{ id = "pl", label = "PL" },
		{ id = "en", label = "EN" },
	}, 138)

	section("sectionInfo")
	local touchChip = Components.Chip(0)
	add(Components.Row({ title = self:_t("touchScreen"), control = touchChip, controlWidth = 110, layoutOrder = 0 }))
	self._touchChip = touchChip

	local reset = Components.Button({
		text = self:_t("reset"),
		layoutOrder = 0,
		onActivated = function()
			settings:Reset()
		end,
	})
	add(reset.instance)
end

-- Dragging -----------------------------------------------------------------------

function Panel:_bindDrag()
	self._maid:Give(self._dragHandle.InputBegan:Connect(function(input)
		if self._drag or not isPointer(input) then
			return
		end
		self._drag = {
			input = input,
			isTouch = input.UserInputType == Enum.UserInputType.Touch,
			start = toVector2(input.Position),
			origin = self._position,
			moved = false,
		}
	end))

	self._maid:Give(UserInputService.InputChanged:Connect(function(input)
		local drag = self._drag
		if not drag then
			return
		end
		if drag.isTouch then
			if input ~= drag.input then
				return
			end
		elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local delta = toVector2(input.Position) - drag.start
		if not drag.moved and delta.Magnitude < DRAG_THRESHOLD then
			return
		end
		drag.moved = true
		self._position = self:_clamp(drag.origin + delta, self:_targetSize())
		self._root.Position = UDim2.fromOffset(self._position.X, self._position.Y)
	end))

	self._maid:Give(UserInputService.InputEnded:Connect(function(input)
		local drag = self._drag
		if not drag then
			return
		end
		local released = if drag.isTouch
			then input == drag.input
			else input.UserInputType == Enum.UserInputType.MouseButton1
		if not released then
			return
		end

		self._drag = nil
		if drag.moved then
			self._customPosition = true
			self._settings:SetState("position", { x = self._position.X, y = self._position.Y })
		elseif self._collapsed then
			-- A plain tap on the collapsed pill opens it again.
			self:SetCollapsed(false)
		end
	end))
end

-- Layout ---------------------------------------------------------------------------

function Panel:_screenSize(): Vector2
	return self._params.parent.AbsoluteSize
end

function Panel:_expandedHeight(): number
	local available = self:_screenSize().Y - Size.ScreenMargin * 2
	return math.max(Size.Header + 220, math.min(Size.PanelHeight, available))
end

function Panel:_targetSize(): Vector2
	if self._collapsed then
		return Vector2.new(Size.CollapsedWidth, Size.Header)
	end
	return Vector2.new(Size.PanelWidth, self:_expandedHeight())
end

function Panel:_clamp(position: Vector2, size: Vector2): Vector2
	local screen = self:_screenSize()
	local margin = Size.ScreenMargin
	local maxX = math.max(margin, screen.X - size.X - margin)
	local maxY = math.max(margin, screen.Y - size.Y - margin)
	return Vector2.new(math.clamp(position.X, margin, maxX), math.clamp(position.Y, margin, maxY))
end

-- Until the user drags the window it lives in the top-right corner of the viewport.
function Panel:_defaultPosition(): Vector2
	return Vector2.new(self:_screenSize().X - Size.PanelWidth - 24, 24)
end

function Panel:_restorePosition()
	local saved = self._settings:GetState("position")
	if type(saved) == "table" and type(saved.x) == "number" and type(saved.y) == "number" then
		self._customPosition = true
		self._position = Vector2.new(saved.x, saved.y)
	else
		self._customPosition = false
		self._position = self:_defaultPosition()
	end
	self:_applyLayout(true)
end

function Panel:_applyLayout(instant: boolean?)
	local size = self:_targetSize()
	self._position = self:_clamp(self._position, size)
	Create.animate(self._root, if instant then nil else Theme.Tween.Smooth, {
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.fromOffset(self._position.X, self._position.Y),
	})
end

function Panel:_selectTab(id: string, instant: boolean?)
	self._tab = id
	local info = if instant then nil else Theme.Tween.Smooth
	Create.animate(self._gesturesPage, info, {
		Position = UDim2.fromScale(if id == "gestures" then 0 else -1, 0),
	})
	Create.animate(self._settingsPage, info, {
		Position = UDim2.fromScale(if id == "settings" then 0 else 1, 0),
	})
	if instant then
		self._tabs.set(id, true)
	end
	self._settings:SetState("tab", id)
	self:_updateAnimations()
end

-- Public API -------------------------------------------------------------------------

function Panel:IsVisible(): boolean
	return self._visible
end

function Panel:IsCollapsed(): boolean
	return self._collapsed
end

function Panel:SetVisible(visible: boolean, instant: boolean?)
	if visible == self._visible then
		return
	end
	self._visible = visible
	self._visibleToken += 1
	self._drag = nil

	if visible then
		self._root.Visible = true
		if instant then
			self._scale.Scale = 1
		else
			self._scale.Scale = 0.9
			Create.tween(self._scale, Theme.Tween.Spring, { Scale = 1 })
		end
	elseif instant then
		self._root.Visible = false
	else
		local token = self._visibleToken
		Create.tween(self._scale, Theme.Tween.Close, { Scale = 0.9 })
		task.delay(Theme.Tween.Close.Time, function()
			if token == self._visibleToken then
				self._root.Visible = false
			end
		end)
	end

	self:_updateAnimations()
end

function Panel:SetCollapsed(collapsed: boolean, instant: boolean?)
	self._collapsed = collapsed
	self._collapseToken += 1
	local info = if instant then nil else Theme.Tween.Smooth

	Create.animate(self._chevron, info, { Rotation = if collapsed then 180 else 0 })

	if not collapsed then
		self._content.Visible = true
	elseif instant then
		self._content.Visible = false
	else
		-- Hide the content (and its inputs) once the window has shrunk.
		local token = self._collapseToken
		task.delay(Theme.Tween.Smooth.Time, function()
			if token == self._collapseToken then
				self._content.Visible = false
			end
		end)
	end

	self:_applyLayout(instant)
	self:_updateAnimations()
end

function Panel:SetActive(active: boolean, instant: boolean?)
	self._active = active
	self._toggle.set(active, instant)
	self:_refreshStatus()
	self:_updateAnimations()
end

function Panel:SetTouchCount(count: number)
	self._touchCount = count
	self:_refreshChips()
end

function Panel:SetGesture(gesture: string?)
	self._gesture = gesture
	self:_refreshChips()
	self:_refreshStatus()
end

function Panel:SetTouchDetected(detected: boolean)
	local chip = self._touchChip
	chip.Text = self:_t(if detected then "detected" else "notDetected")
	chip.TextColor3 = if detected then Color.Success else Color.Warning
end

-- True when a screen point lies on the window (so it should not move the camera).
function Panel:ContainsPoint(point: Vector2): boolean
	if not self._root.Visible then
		return false
	end
	local position = self._body.AbsolutePosition
	local size = self._body.AbsoluteSize
	local margin = 6
	return point.X >= position.X - margin
		and point.X <= position.X + size.X + margin
		and point.Y >= position.Y - margin
		and point.Y <= position.Y + size.Y + margin
end

function Panel:_refreshStatus()
	local color = if self._active then Color.Success else Color.Warning
	local text = self:_t(if self._active then "statusActive" else "statusPaused")
	if self._active and self._gesture then
		text ..= " · " .. self._locale:gesture(self._gesture)
	end
	self._statusLabel.Text = text
	self._statusLabel.TextColor3 = color
	self._statusDot.BackgroundColor3 = color
	self._statusPulse.BackgroundColor3 = color
end

function Panel:_refreshChips()
	local highlight = '<font color="#EEF1F9">%s</font>'
	self._fingersChip.Text = self:_t("fingers") .. "  " .. string.format(highlight, tostring(self._touchCount))
	self._gestureChip.Text = self:_t("gesture") .. "  " .. string.format(highlight, self._locale:gesture(self._gesture))
end

function Panel:_updateAnimations()
	local showIcons = self._visible and not self._collapsed and self._tab == "gestures"
	for _, tween in self._loops do
		if showIcons then
			tween:Play()
		else
			tween:Pause()
		end
	end

	local pulse = self._visible and self._active
	self._statusPulse.Visible = pulse
	if pulse then
		self._pulseTween:Play()
	else
		self._pulseTween:Pause()
	end
end

function Panel:Destroy()
	self._loops = {}
	self._maid:Clean()
end

return Panel
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX19">
				<Properties>
					<string name="Name">Theme</string>
					<ProtectedString name="Source"><![CDATA[local FONT_FAMILY = "rbxasset://fonts/families/BuilderSans.json"

local Theme = {}

Theme.Font = {
	Regular = Font.new(FONT_FAMILY, Enum.FontWeight.Regular),
	Medium = Font.new(FONT_FAMILY, Enum.FontWeight.Medium),
	SemiBold = Font.new(FONT_FAMILY, Enum.FontWeight.SemiBold),
	Bold = Font.new(FONT_FAMILY, Enum.FontWeight.Bold),
	ExtraBold = Font.new(FONT_FAMILY, Enum.FontWeight.ExtraBold),
}

Theme.Color = {
	Background = Color3.fromRGB(15, 17, 24),
	Surface = Color3.fromRGB(23, 26, 36),
	SurfaceHigh = Color3.fromRGB(32, 36, 49),
	SurfaceHover = Color3.fromRGB(44, 49, 66),
	White = Color3.fromRGB(255, 255, 255),
	Black = Color3.fromRGB(0, 0, 0),
	Text = Color3.fromRGB(238, 241, 249),
	TextDim = Color3.fromRGB(150, 158, 182),
	TextFaint = Color3.fromRGB(96, 104, 128),
	Accent = Color3.fromRGB(0, 198, 255),
	AccentAlt = Color3.fromRGB(132, 92, 255),
	Success = Color3.fromRGB(56, 222, 138),
	Warning = Color3.fromRGB(255, 188, 56),
	Danger = Color3.fromRGB(255, 94, 116),
}

Theme.AccentGradient = ColorSequence.new(Theme.Color.Accent, Theme.Color.AccentAlt)

Theme.Tween = {
	Fast = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Smooth = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
	Spring = TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Close = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
}

Theme.Size = {
	PanelWidth = 324,
	PanelHeight = 600,
	CollapsedWidth = 264,
	Header = 62,
	Padding = 14,
	ScreenMargin = 10,
}

return Theme
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX20">
			<Properties>
				<string name="Name">Util</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX21">
				<Properties>
					<string name="Name">Maid</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Collects connections, instances, tweens and cleanup callbacks so they can
	be released together.
]]

local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid:Give<T>(task: T): T
	table.insert(self._tasks, task)
	return task
end

local function cleanup(item)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		if item:IsA("Tween") then
			item:Cancel()
		end
		item:Destroy()
	elseif kind == "function" then
		item()
	elseif kind == "thread" then
		pcall(task.cancel, item)
	elseif kind == "table" then
		if item.Disconnect then
			item:Disconnect()
		elseif item.Destroy then
			item:Destroy()
		end
	end
end

function Maid:Clean()
	local tasks = self._tasks
	self._tasks = {}
	-- Release in reverse order: things created last usually depend on things created first.
	for index = #tasks, 1, -1 do
		cleanup(tasks[index])
	end
end

Maid.Destroy = Maid.Clean

return Maid
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX22">
				<Properties>
					<string name="Name">Signal</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Minimal synchronous signal.

	Handlers run immediately, in the order they were connected, which keeps the
	gesture pipeline deterministic (and easy to test outside of Roblox).
]]

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false

	local connections = self._signal._connections
	local index = table.find(connections, self)
	if index then
		table.remove(connections, index)
	end
end

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _connections = {} }, Signal)
end

function Signal:Connect(callback: (...any) -> ())
	local connection = setmetatable({
		Connected = true,
		_signal = self,
		_callback = callback,
	}, Connection)
	table.insert(self._connections, connection)
	return connection
end

function Signal:Fire(...)
	-- Iterate over a snapshot so handlers may connect/disconnect while firing.
	for _, connection in table.clone(self._connections) do
		if connection.Connected then
			connection._callback(...)
		end
	end
end

function Signal:DisconnectAll()
	for _, connection in self._connections do
		connection.Connected = false
	end
	table.clear(self._connections)
end

Signal.Destroy = Signal.DisconnectAll

return Signal
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
